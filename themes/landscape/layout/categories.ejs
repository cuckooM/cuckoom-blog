<%
  var currentLang = page.lang || "zh-CN";

  var pageTitle = __('categories_page_title');
  var pageDesc = __('categories_page_desc');
%>

<!-- Simplified Hero -->
<section class="hero-section hero-simple">
  <div class="hero-content">
    <h1 class="hero-title"><%= pageTitle %></h1>
    <p class="hero-description"><%= pageDesc %></p>
  </div>
</section>

<!-- Category Cards Grid -->
<div class="category-grid">
  <% if (site.categories && site.categories.length) { %>
    <%
      // Filter categories by language (based on category name)
      var categories = site.categories.toArray().filter(function(cat) {
        if (currentLang === 'en') {
          return !/[\u4e00-\u9fa5]/.test(cat.name) && !/[\uac00-\ud7af]/.test(cat.name) && !/[\u3040-\u30ff]/.test(cat.name);
        }
        if (currentLang === 'ko') {
          return /[\uac00-\ud7af]/.test(cat.name) || !/[\u4e00-\u9fa5]/.test(cat.name);
        }
        if (currentLang === 'ja') {
          return /[\u3040-\u30ff]/.test(cat.name) || !/[\u4e00-\u9fa5]/.test(cat.name);
        }
        return /[\u4e00-\u9fa5]/.test(cat.name);
      });

      // Recalculate category counts based on language
      categories = categories.map(function(cat) {
        var posts = cat.posts.toArray().filter(function(post) {
          if (currentLang === 'en') {
            return post.lang === 'en';
          }
          if (currentLang === 'ko') {
            return post.lang === 'ko';
          }
          if (currentLang === 'ja') {
            return post.lang === 'ja';
          }
          return post.lang !== 'en' && post.lang !== 'ko' && post.lang !== 'ja';
        });
        return {
          name: cat.name,
          path: cat.path,
          length: posts.length,
          posts: posts
        };
      });

      // Remove categories with zero posts
      categories = categories.filter(function(cat) {
        return cat.length > 0;
      });

      categories.forEach(function(cat) {
    %>
    <a href="<%- url_with_lang(cat.path, currentLang) %>" class="category-card">
      <div class="category-card-icon">📚</div>
      <h3 class="category-card-name"><%= cat.name %></h3>
      <p class="category-card-count">
        <%= cat.length %> <%= __('posts_count') %>
      </p>
    </a>
    <% }); %>
  <% } else { %>
    <div class="category-empty">
      <p><%= __('no_categories') %></p>
    </div>
  <% } %>
</div>
