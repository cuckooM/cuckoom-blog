<%
  var currentLang = page.lang || "zh-CN";

  var pageTitle = __('tags_page_title');
  var pageDesc = __('tags_page_desc');
%>

<!-- Simplified Hero -->
<section class="hero-section hero-simple">
  <div class="hero-content">
    <h1 class="hero-title"><%= pageTitle %></h1>
    <p class="hero-description"><%= pageDesc %></p>
  </div>
</section>

<!-- Tag Cloud -->
<div class="tags-cloud-section">
  <% if (site.tags && site.tags.length) { %>
    <%
      // Filter tags by language (based on tag name)
      var tags = site.tags.toArray().filter(function(tag) {
        if (currentLang === 'en') {
          return !/[\u4e00-\u9fa5]/.test(tag.name) && !/[\uac00-\ud7af]/.test(tag.name) && !/[\u3040-\u30ff]/.test(tag.name);
        }
        if (currentLang === 'ko') {
          return /[\uac00-\ud7af]/.test(tag.name) || !/[\u4e00-\u9fa5]/.test(tag.name);
        }
        if (currentLang === 'ja') {
          return /[\u3040-\u30ff]/.test(tag.name) || !/[\u4e00-\u9fa5]/.test(tag.name);
        }
        return /[\u4e00-\u9fa5]/.test(tag.name);
      });

      // Recalculate tag counts based on language
      tags = tags.map(function(tag) {
        var posts = tag.posts.toArray().filter(function(post) {
          if (currentLang === 'en') {
            return post.lang === 'en';
          }
          if (currentLang === 'ko') {
            return post.lang === 'ko';
          }
          if (currentLang === 'ja') {
            return post.lang === 'ja';
          }
          return post.lang !== 'en' && post.lang !== 'ko' && post.lang !== 'ja';
        });
        return {
          name: tag.name,
          path: tag.path,
          length: posts.length,
          posts: posts
        };
      });

      // Remove tags with zero posts
      tags = tags.filter(function(tag) {
        return tag.length > 0;
      });

      var counts = tags.map(function(t) { return t.length; });
      var minCount = tags.length > 0 ? Math.min.apply(Math, counts) : 0;
      var maxCount = tags.length > 0 ? Math.max.apply(Math, counts) : 0;
    %>
    <div class="tags-cloud">
      <% tags.forEach(function(tag) {
        var ratio = (maxCount === minCount) ? 0.5 : (tag.length - minCount) / (maxCount - minCount);
        var fontSize = 14 + 6 * ratio; // 14px to 20px
      %>
      <a href="<%- url_with_lang(tag.path, currentLang) %>" class="tag-cloud-item" style="font-size: <%= fontSize %>px;">
        #<%= tag.name %>
      </a>
      <% }); %>
    </div>

    <!-- Tag List with counts -->
    <div class="tags-list-section">
      <div class="tags-list-grid">
        <% tags.forEach(function(tag) { %>
        <a href="<%- url_with_lang(tag.path, currentLang) %>" class="tag-list-item">
          <span class="tag-list-name">#<%= tag.name %></span>
          <span class="tag-list-count"><%= tag.length %></span>
        </a>
        <% }); %>
      </div>
    </div>
  <% } else { %>
    <div class="tags-empty">
      <p><%= __('no_tags') %></p>
    </div>
  <% } %>
</div>
