<h1 class="page-title"><%= page.title %></h1>

<div class="tags-list">
  <h2 class="widget-title">标签云</h2>
  <div class="widget tagcloud">
    <% if (page.tag_names && Array.isArray(page.tag_names) && page.tag_names.length > 0) { %>
      <%- generateEnglishTagcloud(page.tag_names) %>
    <% } else { %>
      <%- tagcloud({min_font: 10, max_font: 20, amount: 100, color: true, start_color: '#ccc', end_color: '#111'}) %>
    <% } %>
  </div>

  <h2 class="widget-title">标签列表</h2>
  <div class="widget">
    <ul class="tag-list" itemprop="keywords">
      <% if (page.tag_names && Array.isArray(page.tag_names) && page.tag_names.length > 0) { %>
        <% page.tag_names.forEach(function(tagObj){ %>
        <li class="tag-list-item">
          <% var tagName = typeof tagObj === 'string' ? tagObj : tagObj.name; %>
          <a class="tag-list-link" href="<%- url_for('en/tags/' + tagName + '/') %>" rel="tag">
            <%= tagName %>
          </a>
        </li>
        <% }); %>
      <% } else { %>
      <% } %>
    </ul>
  </div>
</div>
