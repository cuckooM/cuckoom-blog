<!DOCTYPE html>
<html lang="<%= page.lang || config.language || 'zh-CN' %>">
<%- partial('_partial/head') %>
<body>
  <div id="container">
    <div id="wrap">
      <%- partial('_partial/header', {page: page}, {cache: false}) %>

      <main class="main-content">
        <div class="outer">
          <section id="main"><%- body %></section>
        </div>
      </main>

      <%- partial('_partial/footer', null, {cache: !config.relative_link}) %>
    </div>

    <!-- Mobile Navigation Drawer -->
    <%- partial('_partial/mobile-nav-drawer', {page: page}, {cache: false}) %>

    <!-- Sidebar Drawer Overlay -->
    <div class="drawer-overlay"></div>

    <!-- Sidebar Drawer -->
    <%- partial('_partial/sidebar-drawer', null, {cache: false}) %>

    <!-- After-footer scripts -->
    <%- partial('_partial/after-footer') %>
  </div>

  <!-- Theme Toggle Script -->
  <script src="<%- url_for('/js/theme-toggle.js') %>"></script>
</body>
</html>
