<!DOCTYPE html>
<html lang="<%= page.lang || config.language || 'zh-CN' %>">
<%- partial('_partial/head') %>
<body>
  <div id="container">
    <div id="wrap">
      <%- partial('_partial/header', {page: page}, {cache: false}) %>

      <main class="main-content">
        <div class="outer">
          <section id="main">
            <% if (is_home()) { %>
              <%- partial('index') %>
            <% } else if (is_archive()) { %>
              <%- partial('archive') %>
            <% } else if (page.type === 'categories') { %>
              <%- partial('categories') %>
            <% } else if (page.type === 'tags') { %>
              <%- partial('tags') %>
            <% } else { %>
              <%- partial('page') %>
            <% } %>
          </section>
        </div>
      </main>

      <%- partial('_partial/footer', null, {cache: !config.relative_link}) %>
    </div>

    <!-- Mobile Navigation -->
    <%- partial('_partial/mobile-nav', null, {cache: !config.relative_link}) %>

    <!-- Sidebar Drawer Overlay -->
    <div class="drawer-overlay"></div>

    <!-- Sidebar Drawer -->
    <%- partial('_partial/sidebar-drawer', null, {cache: false}) %>

    <!-- After-footer scripts -->
    <%- partial('_partial/after-footer') %>
  </div>

  <!-- Theme Toggle Script -->
  <script src="<%- url_for('/js/theme-toggle.js') %>"></script>
</body>
</html>
