<%
  var currentLang = page.lang || "zh-CN";

  // Get all posts
  var allPosts = (locals && locals.posts ? locals.posts.toArray() : (site.posts ? site.posts.toArray() : []));
  var filteredPosts = allPosts.filter(function(post) {
    if (currentLang === 'en') {
      return post.lang === 'en';
    }
    if (currentLang === 'ko') {
      return post.lang === 'ko';
    }
    if (currentLang === 'ja') {
      return post.lang === 'ja';
    }
    return post.lang !== 'en' && post.lang !== 'ko' && post.lang !== 'ja';
  });

  // Check if we're on a specific year/month archive page
  var currentYear = page && page.year ? parseInt(page.year) : null;
  var currentMonth = page && page.month ? parseInt(page.month) : null;

  // Group by year and month
  var archives = {};
  filteredPosts.forEach(function(post) {
    var year = post.date.year();
    var month = post.date.month() + 1; // 1-based

    // If we're on a specific year/month page, only include matching posts
    if (currentYear && year !== currentYear) return;
    if (currentMonth && month !== currentMonth) return;

    if (!archives[year]) archives[year] = {};
    if (!archives[year][month]) archives[year][month] = [];
    archives[year][month].push(post);
  });

  var monthNames;
  if (currentLang === 'en') {
    monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  } else if (currentLang === 'ko') {
    monthNames = ['1월', '2월', '3월', '4월', '5월', '6월', '7월', '8월', '9월', '10월', '11월', '12월'];
  } else if (currentLang === 'ja') {
    monthNames = ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'];
  } else {
    monthNames = ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'];
  }

  var pageTitle = currentLang === 'en' ? 'Archives' : currentLang === 'ko' ? '아카이브' : currentLang === 'ja' ? 'アーカイブ' : '归档';
  if (currentYear && currentMonth) {
    pageTitle = monthNames[currentMonth - 1] + ' ' + currentYear;
  } else if (currentYear) {
    pageTitle = currentYear;
  }
  var pageDesc = currentLang === 'en' ? 'All posts organized by date' : currentLang === 'ko' ? '날짜별 정렬된 모든 글' : currentLang === 'ja' ? '日付順に整理されたすべての記事' : '按日期排列的所有文章';
%>

<!-- Simplified Hero -->
<section class="hero-section hero-simple">
  <div class="hero-content">
    <h1 class="hero-title"><%= pageTitle %></h1>
    <p class="hero-description"><%= pageDesc %></p>
  </div>
</section>

<!-- Archive Timeline -->
<div class="archive-timeline">
  <%
    var years = Object.keys(archives).sort(function(a, b) { return b - a; });
    years.forEach(function(year) {
      var months = archives[year];
      var sortedMonths = Object.keys(months).sort(function(a, b) { return b - a; });
  %>
  <div class="archive-year">
    <h2 class="archive-year-title"><%= year %></h2>
    <% sortedMonths.forEach(function(month) { %>
    <div class="archive-month">
      <h3 class="archive-month-title"><%= monthNames[parseInt(month) - 1] %></h3>
      <div class="archive-month-posts">
        <% months[month].forEach(function(post) { %>
        <div class="archive-post-item">
          <span class="archive-post-date"><%- date(post.date, 'DD') %></span>
          <a href="<%- post_url_i18n(post) %>" class="archive-post-title"><%= post.title %></a>
          <% if (post.tags && post.tags.length) { %>
          <span class="archive-post-tags">
            <% post.tags.forEach(function(tag) { %>
            <a href="<%- url_with_lang(tag.path, currentLang) %>" class="tag-pill">#<%= tag.name %></a>
            <% }) %>
          </span>
          <% } %>
        </div>
        <% }); %>
      </div>
    </div>
    <% }); %>
  </div>
  <% }); %>

  <% if (years.length === 0) { %>
  <div class="archive-empty">
    <% if (currentLang === 'en') { %>
    <p>No posts yet.</p>
    <% } else if (currentLang === 'ko') { %>
    <p>아직 글이 없습니다.</p>
    <% } else if (currentLang === 'ja') { %>
    <p>まだ記事がありません。</p>
    <% } else { %>
    <p>暂无文章。</p>
    <% } %>
  </div>
  <% } %>
</div>
