<%
  // Get current language from page.lang (injected by multi_lang_generator)
  var currentLang = page.lang || "zh-CN";

  // Get posts for this language
  var allPosts = (locals && locals.posts ? locals.posts.toArray() : (site.posts ? site.posts.toArray() : []));
  var filteredPosts = allPosts.filter(function(post) {
    if (currentLang === 'en') {
      return post.lang === 'en';
    }
    if (currentLang === 'ko') {
      return post.lang === 'ko';
    }
    // 中文页面：只显示中文文章（非英文、非韩文）
    return post.lang !== 'en' && post.lang !== 'ko';
  });
  // Sort by date descending (newest first)
  var posts = filteredPosts.sort(function(a, b) {
    return b.date - a.date;
  });
%>

<!-- Hero Section (Full) -->
<section class="hero-section hero-full">
  <div class="hero-content">
    <h1 class="hero-title"><%= config.title %></h1>
    <% if (theme.subtitle || config.subtitle) { %>
    <p class="hero-subtitle"><%= theme.subtitle || config.subtitle %></p>
    <% } %>
    <% if (currentLang === 'zh-CN') { %>
    <p class="hero-description">一个关于编程、技术和生活的个人博客</p>
    <% } else if (currentLang === 'ko') { %>
    <p class="hero-description">프로그래밍, 기술, 그리고 생활에 대한 개인 블로그</p>
    <% } else { %>
    <p class="hero-description">A personal blog about coding, technology & life</p>
    <% } %>
  </div>
</section>

<!-- Article Cards -->
<div class="article-card-list">
  <% if (posts && posts.length) { %>
    <% posts.forEach(function(post) { %>
      <article class="article-card">
        <!-- Card Title -->
        <h2 class="card-title">
          <a href="<%- post_url_i18n(post) %>"><%= post.title || '(no title)' %></a>
        </h2>

        <!-- Card Meta -->
        <div class="card-meta">
          <span class="meta-item"><%- date(post.date, 'YYYY-MM-DD') %></span>
                    <% if (post.categories && post.categories.length) { %>
                      <span class="meta-item">
                        <a href="<%- url_with_lang(post.categories.data[0].path, currentLang) %>"><%= post.categories.data[0].name %></a>
                      </span>
                    <% } %>
        </div>

        <!-- Card Excerpt -->
        <% if (post.excerpt) { %>
        <div class="card-excerpt">
          <%- post.excerpt %>
        </div>
        <% } else if (post.content) { %>
        <div class="card-excerpt">
          <%- post.content.substring(0, 200) %><% if (post.content.length > 200) { %>...<% } %>
        </div>
        <% } %>

        <!-- Card Tags -->
        <% if (post.tags && post.tags.length) { %>
                <div class="card-tags">
                  <% post.tags.forEach(function(tag) { %>
                  <a href="<%- url_with_lang(tag.path, currentLang) %>" class="tag-pill">#<%= tag.name %></a>
                  <% }) %>
                </div>
                <% } %>

        <!-- Read More -->
        <div class="card-read-more">
          <a href="<%- post_url_i18n(post) %>"><%- currentLang === 'en' ? 'Read More &rarr;' : currentLang === 'ko' ? '더 읽기 &rarr;' : '阅读更多 &rarr;' %></a>
        </div>
      </article>
    <% }); %>
  <% } else { %>
    <div class="article-card">
      <% if (currentLang === 'en') { %>
      <p>No posts yet. Check back soon!</p>
      <% } else if (currentLang === 'ko') { %>
      <p>아직 게시물이 없습니다. 곧 새로운 글이 올라옵니다!</p>
      <% } else { %>
      <p>暂无文章，敬请期待！</p>
      <% } %>
    </div>
  <% } %>
</div>

<!-- Pagination -->
<% 
  // 根据实际文章数计算分页，而非使用 page.total
  var perPage = config.per_page || 10;
  var actualTotalPages = Math.ceil(filteredPosts.length / perPage);
  if (actualTotalPages <= 1) actualTotalPages = 1;
%>
<% if (actualTotalPages > 1 && page.current <= actualTotalPages) { %>
<nav class="pagination">
  <%- paginator({
    prev_text: '&laquo; ' + (currentLang === 'en' ? 'Prev' : currentLang === 'ko' ? '이전' : '上一页'),
    next_text: (currentLang === 'en' ? 'Next' : currentLang === 'ko' ? '다음' : '下一页') + ' &raquo;',
    total: actualTotalPages,
    escape: false
  }) %>
</nav>
<% } %>
