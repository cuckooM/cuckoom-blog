<%
  var currentLang = page.lang || "zh-CN";

  var pageTitle = currentLang === 'en' ? 'Search' : currentLang === 'ko' ? '검색' : currentLang === 'ja' ? '検索' : '搜索';
  var placeholder = currentLang === 'en' ? 'Search articles...' : currentLang === 'ko' ? '글 검색...' : currentLang === 'ja' ? '記事を検索...' : '输入关键词搜索文章...';
  var emptyMsg = currentLang === 'en' ? 'No results found. Try different keywords.' : currentLang === 'ko' ? '결과가 없습니다. 다른 키워드를 사용해 보세요.' : currentLang === 'ja' ? '結果が見つかりませんでした。別のキーワードをお試しください。' : '没有找到结果，试试其他关键词。';
%>

<!-- Simplified Hero -->
<section class="hero-section hero-simple">
  <div class="hero-content">
    <h1 class="hero-title"><%= pageTitle %></h1>
  </div>
</section>

<!-- Search Box -->
<div class="search-page-container">
  <div class="search-page-box">
    <form class="search-page-form" onsubmit="return false;">
      <span class="search-page-icon">&#xF002;</span>
      <input type="search" id="search-page-input" class="search-page-input" placeholder="<%= placeholder %>">
    </form>
  </div>

  <!-- Search Results -->
  <div id="search-page-results" class="search-page-results">
    <div class="search-page-empty">
      <p><%= emptyMsg %></p>
    </div>
  </div>
</div>

<script>
  (function() {
    var searchData = null;
    var searchPath = "/search.xml";
    var currentLang = '<%= currentLang %>';

    function loadSearchData() {
      if (searchData !== null) return;
      $.get(searchPath, function(data) { searchData = data; }, 'xml');
    }

    function getSearchResults(query) {
      if (!searchData) return [];
      var results = [], keywords = query.trim().toLowerCase().split(/\s+/);
      $(searchData).find('entry').each(function() {
        var $entry = $(this),
            title = $entry.find('title').text(),
            url = $entry.find('url').text(),
            content = $entry.find('content').text(),
            tags = $entry.find('tag').map(function() { return $(this).text(); }).get().join(' '),
            categories = $entry.find('category').map(function() { return $(this).text(); }).get().join(' '),
            titleLower = title.toLowerCase(),
            contentLower = content.toLowerCase(),
            tagsLower = tags.toLowerCase(),
            categoriesLower = categories.toLowerCase(),
            matchCount = 0;
        for (var i = 0; i < keywords.length; i++) {
          if (keywords[i]) {
            if (titleLower.indexOf(keywords[i]) > -1) matchCount += 3;
            if (tagsLower.indexOf(keywords[i]) > -1) matchCount += 2;
            if (categoriesLower.indexOf(keywords[i]) > -1) matchCount += 2;
            if (contentLower.indexOf(keywords[i]) > -1) matchCount += 1;
          }
        }
        if (matchCount > 0) {
          var index = contentLower.indexOf(keywords[0] || ''),
              snippetStart = index > 80 ? index - 80 : 0,
              snippet = content.substring(snippetStart, snippetStart + 200);
          if (content.length > 200) snippet += '...';
          results.push({ title: title, url: url, snippet: snippet, score: matchCount });
        }
      });
      results.sort(function(a, b) { return b.score - a.score; });
      return results.slice(0, 20);
    }

    function renderResults(results) {
      var html = '';
      if (results.length === 0) {
        html = '<div class="search-page-empty"><p>' +
          (currentLang === 'en' ? 'No results found.' : currentLang === 'ko' ? '결과가 없습니다.' : currentLang === 'ja' ? '結果が見つかりませんでした。' : '没有找到结果') + '</p></div>';
      } else {
        results.forEach(function(item) {
          html += '<a href="' + item.url + '" class="search-page-result-item">' +
            '<h3 class="search-page-result-title">' + item.title + '</h3>' +
            '<p class="search-page-result-snippet">' + item.snippet + '</p>' +
            '</a>';
        });
      }
      return html;
    }

    loadSearchData();

    // Read URL query parameter on page load
    var urlParams = new URLSearchParams(window.location.search);
    var initialQuery = urlParams.get('q');
    if (initialQuery) {
      $('#search-page-input').val(decodeURIComponent(initialQuery));
      // Trigger search after data loads
      var initTimer = setInterval(function() {
        if (searchData) {
          clearInterval(initTimer);
          $('#search-page-results').html(renderResults(getSearchResults(initialQuery)));
        }
      }, 100);
      setTimeout(function() { clearInterval(initTimer); }, 2000);
    }

    var debounceTimer;
    $('#search-page-input').on('input', function() {
      clearTimeout(debounceTimer);
      var query = $(this).val().trim();
      if (!query) {
        $('#search-page-results').html(
          '<div class="search-page-empty"><p>' +
          (currentLang === 'en' ? 'Enter keywords to search...' : currentLang === 'ko' ? '검색어를 입력하세요...' : currentLang === 'ja' ? '検索キーワードを入力...' : '输入关键词搜索...') + '</p></div>'
        );
        return;
      }
      debounceTimer = setTimeout(function() {
        if (searchData) {
          $('#search-page-results').html(renderResults(getSearchResults(query)));
        } else {
          loadSearchData();
          var timer = setInterval(function() {
            if (searchData) {
              clearInterval(timer);
              $('#search-page-results').html(renderResults(getSearchResults(query)));
            }
          }, 100);
          setTimeout(function() { clearInterval(timer); }, 2000);
        }
      }, 300);
    });
  })();
</script>
