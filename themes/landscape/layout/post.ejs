<%
  var currentLang = page.lang || "zh-CN";
  // 使用同语言导航 helper 解决跨语言导航问题
  var nav = get_i18n_post_nav(page);
%>

<!-- Simplified Hero for Post Page -->
<section class="hero-section hero-simple">
  <div class="hero-content">
    <h1 class="hero-title"><%= page.title || '(no title)' %></h1>
  </div>
</section>

<!-- Article Content -->
<article class="article-detail">
  <!-- Meta Info -->
  <div class="article-meta-bar">
    <span class="meta-date"><%- date(page.date, 'YYYY-MM-DD') %></span>
    <% if (page.categories && page.categories.length) { %>
      <span class="meta-sep">&middot;</span>
      <a href="<%- url_with_lang(page.categories.data[0].path, currentLang) %>" class="meta-category"><%= page.categories.data[0].name %></a>
    <% } %>
    <% if (page.tags && page.tags.length) { %>
      <span class="meta-sep">&middot;</span>
      <span class="meta-tags">
        <% page.tags.forEach(function(tag) { %>
        <a href="<%- url_with_lang(tag.path, currentLang) %>" class="tag-pill">#<%= tag.name %></a>
        <% }) %>
      </span>
    <% } %>
  </div>

  <!-- Article Body -->
  <div class="article-body e-content" itemprop="articleBody">
    <%- page.content %>
  </div>
</article>

<!-- Post Navigation (Language-isolated) -->
<% if (nav.prev || nav.next) { %>
<nav class="post-navigation">
  <% if (nav.prev) { %>
  <a href="<%- post_url_i18n(nav.prev) %>" class="post-nav-item post-nav-prev">
    <span class="post-nav-label">&larr; <%= __('post_prev') %></span>
    <span class="post-nav-title"><%= nav.prev.title %></span>
  </a>
  <% } %>
  <% if (nav.next) { %>
  <a href="<%- post_url_i18n(nav.next) %>" class="post-nav-item post-nav-next">
    <span class="post-nav-label"><%= __('post_next') %> &rarr;</span>
    <span class="post-nav-title"><%= nav.next.title %></span>
  </a>
  <% } %>
</nav>
<% } %>

<!-- Comments -->
<% if (page.comments && theme.disqus_shortname) { %>
<section id="comments">
  <div id="disqus_thread">
    <noscript>Please enable JavaScript to view the <a href="//disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>
  </div>
</section>
<% } %>
<% if (page.comments && theme.valine && theme.valine.enable && theme.valine.appId && theme.valine.appKey) { %>
<section id="comments" class="vcomment"></section>
<% } %>