<% if (post.tags && Array.isArray(post.tags) && post.tags.length){ %>
  <% var currentLang = page.lang || post.lang || 'zh-CN'; %>
  <ul class="article-tag-list">
    <% post.tags.forEach(function(tag){ %>
      <li class="article-tag-list-item">
        <a class="article-tag-list-link" href="<%- url_with_lang('/tags/' + tag.toLowerCase().replace(/ /g, '-') + '/', currentLang) %>">
          <%= tag %>
        </a>
      </li>
    <% }) %>
  </ul>
<% } %>
