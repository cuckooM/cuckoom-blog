<nav id="mobile-nav">
  <%
    var currentLang = page.lang || "zh-CN";
  %>
  <% var menuCategories = filter_categories_by_lang(site.categories, currentLang); %>
  <% menuCategories.forEach(function(cat) { %>
    <a href="<%- url_with_lang(cat.path, currentLang) %>" class="mobile-nav-link"><%= cat.name %></a>
  <% }); %>
</nav>