<%
  // Language detection
  var currentLang = 'zh-CN';
  if (page && page.path) {
    if (page.path.startsWith('en/')) {
      currentLang = 'en';
    }
  }

  // Toggle: show the opposite language label
  var toggleLabel = (currentLang === 'zh-CN') ? 'EN' : '中文';
  var togglePath = (currentLang === 'zh-CN') ? '/en/' : '/';
%>

<a href="<%= togglePath %>" class="lang-switcher-btn" title="Switch language"><%= toggleLabel %></a>
