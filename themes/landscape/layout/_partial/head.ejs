<head>
  <meta charset="utf-8">
  <%- partial('google-analytics') %>
  <%
  var currentLang = page.lang || "zh-CN";
  var title = page.title;
  var ogUrl = page.permalink || page.path;

  // Helper function for i18n based on page language
  function i18n(key) {
    var translations = {
      'archive_a': { 'en': 'Archives', 'ko': '아카이브', 'ja': 'アーカイブ', 'zh-CN': '归档' },
      'category': { 'en': 'Category', 'ko': '카테고리', 'ja': 'カテゴリー', 'zh-CN': '分类' },
      'tag': { 'en': 'Tag', 'ko': '태그', 'ja': 'タグ', 'zh-CN': '标签' },
      'categories': { 'en': 'Categories', 'ko': '카테고리', 'ja': 'カテゴリー', 'zh-CN': '分类' },
      'tags': { 'en': 'Tags', 'ko': '태그', 'ja': 'タグ', 'zh-CN': '标签' },
      'about': { 'en': 'About', 'ko': '소개', 'ja': 'について', 'zh-CN': '关于' }
    };
    if (translations[key] && translations[key][currentLang]) {
      return translations[key][currentLang];
    }
    return __(key);
  }

  // Check if this is a tags/categories/about page based on path
  var pagePath = page.path || '';
  var isTagsPage = pagePath.indexOf('/tags/') !== -1 || pagePath.indexOf('tags/index.html') !== -1;
  var isCategoriesPage = pagePath.indexOf('/categories/') !== -1 || pagePath.indexOf('categories/index.html') !== -1;
  var isAboutPage = pagePath.indexOf('/about/') !== -1 || pagePath.indexOf('about/index.html') !== -1;

  if (is_archive()){
    title = i18n('archive_a');

    if (is_month()){
      title += ': ' + page.year + '/' + page.month;
    } else if (is_year()){
      title += ': ' + page.year;
    }
  } else if (is_category()){
    title = i18n('category') + ': ' + page.category;
  } else if (is_tag()){
    title = i18n('tag') + ': ' + page.tag;
  } else if (isCategoriesPage){
    title = i18n('categories');
  } else if (isTagsPage){
    title = i18n('tags');
  } else if (isAboutPage){
    title = i18n('about');
  }

  // 修复 og:url：英文文章需要 /en/ 前缀
  // 注意：i18n generator 生成的分类/标签页面 page.path 已包含 /en/ 前缀，需避免重复
  if (page.lang && page.lang !== 'zh-CN' && page.path) {
    var langPrefix = page.lang.toLowerCase() + '/';
    if (page.path.indexOf(langPrefix) === 0) {
      // 路径已包含语言前缀，直接使用
      ogUrl = config.url + '/' + page.path;
    } else {
      // 路径不含语言前缀，需要添加
      ogUrl = config.url + '/' + langPrefix + page.path;
    }
  }
  %>
  <title><% if (title){ %><%= title %> | <% } %><%= config.title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <%- open_graph({twitter_id: theme.twitter, fb_admins: theme.fb_admins, fb_app_id: theme.fb_app_id, url: ogUrl}) %>
  <% if (config.feed) { %>
    <%- feed_tag() %>
  <% } else if (theme.rss) { %>
    <%- feed_tag(theme.rss) %>
  <% } %>
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <% if (config.highlight.enable){ %>
    <%- css('https://cdn.jsdelivr.net/npm/typeface-source-code-pro@0.0.71/index.min.css') %>
  <% } %>
  <%- css('css/style') %>
  <% if (theme.fancybox){ %>
    <%- css('fancybox/jquery.fancybox.min.css') %>
  <% } %>
  <%- css('https://cdn.jsdelivr.net/npm/fork-awesome@1.2.0/css/fork-awesome.min.css') %>
  <script src="/js/jquery-3.6.4.min.js"></script>
</head>
