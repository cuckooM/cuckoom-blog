<%
  // Get current language from page object
  var currentLang = 'zh-CN';

  if (typeof page !== 'undefined' && page && page.path && page.path.startsWith('en/')) {
    currentLang = 'en';
  }
  // Check localStorage for browser environment
  else if (typeof localStorage !== 'undefined' && typeof window !== 'undefined') {
    var langFromStorage = localStorage.getItem('preferredLang');
    if (langFromStorage === 'en' || langFromStorage === 'zh-CN') {
      currentLang = 'en';
    }
  }
%>
<%
  // Get all posts from different sources
  var allPosts = [];
  if (locals && locals.posts) {
    allPosts = locals.posts.toArray ? locals.posts.toArray() : (locals.posts.all ? locals.posts.all() : Array.from(locals.posts));
  } else if (page && page.posts) {
    allPosts = page.posts.toArray ? page.posts.toArray() : (page.posts.all ? page.posts.all() : Array.from(page.posts));
  } else if (locals && locals.site && locals.site.posts) {
    allPosts = locals.site.posts.toArray ? locals.site.posts.toArray() : (locals.site.posts.all ? locals.site.posts.all() : Array.from(locals.site.posts));
  }

  // Filter posts by language
  var filteredPosts = allPosts.filter(function(post) {
    var postLang = post.lang;
    if (!postLang) {
      // Default language detection based on path
      if (currentLang === 'en' && post.path && post.path.startsWith('en/')) {
        postLang = 'en';
      } else if (currentLang === 'zh-CN' && (!post.path || !post.path.startsWith('en/'))) {
        postLang = 'zh-CN';
      } else {
        postLang = currentLang;
      }
    }
    return (postLang === currentLang);
  });
%>
<% if (expand){ %>
  <% if (filteredPosts && filteredPosts.length) { %>
    <% filteredPosts.forEach(function(post){ %>
      <%- partial('article', {post: post, index: true}) %>
    <% }) %>
  <% } %>
<% } else { %>
  <% if (filteredPosts && filteredPosts.length) { %>
    <% var last; %>
    <% filteredPosts.forEach(function(post, i){ %>
      <% var year = post.date.year(); %>
      <% if (last != year){ %>
        <% if (last != null){ %>
          </div></section>
        <% } %>
        <% last = year; %>
        <section class="archives-wrap">
          <div class="archive-year-wrap">
            <a href="<%- url_for(config.archive_dir + '/' + year) %>" class="archive-year"><%= year %></a>
          </div>
          <div class="archives">
      <% } %>
      <%- partial('archive-post', {post: post, even: i % 2 == 0}) %>
    <% }) %>
    <% if (filteredPosts.length){ %>
      </div></section>
    <% } %>
  <% } else { %>
    <div class="no-posts">
      <p>No posts found.</p>
    </div>
  <% } %>
<% } %>
<% if (page && page.total > 1){ %>
  <nav id="page-nav">
    <% var prev_text = "&laquo; " + __('prev');var next_text = __('next') + " &raquo;"%>
    <%- paginator({
      prev_text: prev_text,
      next_text: next_text,
      escape: false
    }) %>
  </nav>
<% } %>
