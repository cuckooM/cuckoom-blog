<header id="header">
  <div id="banner"></div>
  <div id="header-outer" class="outer">
    <div id="header-title" class="inner">
      <h1 id="logo-wrap">
        <a href="<%- url_for() %>" id="logo"><%= config.title %></a>
      </h1>
      <% if (theme.subtitle || config.subtitle){ %>
        <h2 id="subtitle-wrap">
          <a href="<%- url_for() %>" id="subtitle"><%= theme.subtitle || config.subtitle %></a>
        </h2>
      <% } %>
    </div>
    <div id="header-inner" class="inner">
      <nav id="main-nav">
        <a id="main-nav-toggle" class="nav-icon"><span class="fa fa-bars"></span></a>
        <% if (config.theme_config && config.theme_config.menu) { %>
          <%
            // Simplified language detection for non-i18n mode
            // All posts are in Chinese, menu changes based on UI language preference
            var currentLang = 'zh-CN';
            if (page && page.path) {
              if (page.path.startsWith('en/')) {
                currentLang = 'en';
              }
            }

            var menuData = config.theme_config.menu[currentLang] || config.theme_config.menu['zh-CN'] || config.theme_config.menu;
            for (var i in menuData){
              if (typeof menuData[i] === 'string') {
                var title = i;
                var url = menuData[i];
          %>
              <a class="main-nav-link" href="<%- url_for(url) %>"><%= title %></a>
          <%
              }
            }
          %>
        <% } %>
      </nav>
      <nav id="sub-nav">
        <%- partial('_partial/language-switcher', {page: page, currentLang: currentLang}, {cache: false}) %>
        <% if (theme.links) { %>
          <% for (const i in theme.links) {%>
            <a class="nav-icon" target="_blank" rel="noopener" href="<%- url_for(theme.links[i]) %>"><span class="fa fa-<%= i %>"></span></a>
          <% } %>
        <% } %>
        <a class="nav-icon nav-search-btn" title="<%= __('search') %>"><span class="fa fa-search"></span></a>
      </nav>
      <div id="search-form-wrap">
        <form action="/" method="get" class="search-form">
          <input type="search" id="search-input" class="search-form-input" placeholder="搜索">
          <button type="submit" class="search-form-submit">&#xF002;</button>
        </form>
        <div id="search-result" class="search-result"></div>
      </div>
    </div>
  </div>
</header>

<script>
  // Local search
  var searchData = null;
  var searchPath = "/search.xml";

  function loadSearchData() {
    if (searchData !== null) return;
    $.get(searchPath, function(data) { searchData = data; }, 'xml');
  }

  function getSearchResults(query) {
    if (!searchData) return [];
    var results = [], keywords = query.trim().toLowerCase().split(/\s+/);
    $(searchData).find('entry').each(function() {
      var title = $(this).find('title').text(),
          url = $(this).find('url').text(),
          content = $(this).find('content').text(),
          titleLower = title.toLowerCase(),
          contentLower = content.toLowerCase(),
          matchCount = 0;
      for (var i = 0; i < keywords.length; i++) {
        if (keywords[i]) {
          if (titleLower.indexOf(keywords[i]) > -1) matchCount += 2;
          if (contentLower.indexOf(keywords[i]) > -1) matchCount += 1;
        }
      }
      if (matchCount > 0) {
        var index = contentLower.indexOf(keywords[0] || ''),
            snippetStart = index > 50 ? index - 50 : 0,
            snippet = content.substring(snippetStart, snippetStart + 150);
        if (content.length > 150) snippet += '...';
        results.push({ title: title, url: url, snippet: snippet, score: matchCount });
      }
    });
    results.sort(function(a, b) { return b.score - a.score; });
    return results.slice(0, 20);
  }

  function renderSearchResults(results) {
    var html = '<div class="search-result-list">';
    if (results.length === 0) {
      html += '<div class="search-no-result"><p>没有找到结果</p></div>';
    } else {
      results.forEach(function(item) {
        html += '<div class="search-result-item"><a href="' + item.url + '" class="search-result-title">' + item.title + '</a><p class="search-result-content">' + item.snippet + '</p></div>';
      });
    }
    html += '</div>';
    return html;
  }

  function handleSearch(query) {
    if (!query) return;
    loadSearchData();
    var timer = setInterval(function() {
      if (searchData) {
        clearInterval(timer);
        $('#search-result').html(renderSearchResults(getSearchResults(query)));
      }
    }, 100);
    setTimeout(function() { clearInterval(timer); }, 2000);
  }

  // Check for URL query parameter on page load
  $(document).ready(function() {
    // Initial load
    loadSearchData();

    // Bind search form submit
    $('body').on('submit', '.search-form', function(e) {
      e.preventDefault();
      var query = $('#search-input').val();
      if (query) {
        // Update URL
        var newUrl = window.location.pathname + (window.location.pathname.endsWith('/') ? '' : '/') + '?q=' + encodeURIComponent(query);
        window.history.pushState(null, null, newUrl);
        handleSearch(query);
      }
    });

    // Check for URL query parameter on page load
    var urlParams = new URLSearchParams(window.location.search);
    var query = urlParams.get('q');
    if (query) {
      $('#search-input').val(decodeURIComponent(query));
      handleSearch(query);
    }
  });
</script>
