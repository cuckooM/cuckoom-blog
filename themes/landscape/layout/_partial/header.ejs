<header id="header" class="site-header">
  <div class="header-inner outer">
    <!-- Logo / Site Title -->
    <%
      var currentLang = page.lang || "zh-CN";
      var headerLang = currentLang;
    %>
    <a href="<%- url_with_lang('', headerLang) %>" class="header-logo">
      <span class="logo-text"><%= title_i18n() %></span>
    </a>

    <!-- Navigation Links -->
    <%
      var menuTitle = __('menu_title');
      var sidebarTitle = __('sidebar_title');
      var themeTitle = __('theme_toggle');
      var searchPlaceholder = __('search_placeholder');
    %>
    <nav id="main-nav" class="main-nav">
      <a id="main-nav-toggle" class="nav-icon mobile-menu-toggle" title="<%= menuTitle %>"><span class="fa fa-bars"></span></a>
      <% if (config.theme_config && config.theme_config.menu) { %>
        <%
          var menuData = config.theme_config.menu[currentLang] || config.theme_config.menu['zh-CN'] || config.theme_config.menu;
          for (var i in menuData){
            if (typeof menuData[i] === 'string') {
              var title = i;
              var url = menuData[i];
              // Determine if this is the current page
              var isCurrent = false;
              if (url === '' && is_home()) {
                isCurrent = true;
              } else if (url === 'archives' && is_archive()) {
                isCurrent = true;
              } else if (url === 'categories' && (is_category() || page.type === 'categories')) {
                isCurrent = true;
              } else if (url === 'tags' && (is_tag() || page.type === 'tags')) {
                isCurrent = true;
              } else if (url === 'about' && page.path && page.path.indexOf('about') > -1) {
                isCurrent = true;
              }
        %>
          <a class="main-nav-link<% if (isCurrent) { %> active<% } %>" href="<%- url_with_lang(url, currentLang) %>"><%= title %></a>
        <%
            }
          }
        %>
      <% } %>
    </nav>

    <!-- Action Buttons (right side) -->
    <nav id="sub-nav" class="sub-nav">
      <!-- Sidebar Toggle -->
      <button class="sidebar-toggle-btn" id="sidebar-toggle" title="<%= sidebarTitle %>" aria-label="<%= sidebarTitle %>">
        <span class="fa fa-bars"></span>
      </button>

      <!-- Theme Toggle -->
      <button class="theme-toggle-btn" aria-label="<%= themeTitle %>">
        <span class="theme-icon" aria-hidden="true">🌙</span>
      </button>

      <!-- Language Switcher -->
      <%- partial('_partial/language-switcher', {page: page, currentLang: currentLang}, {cache: false}) %>

      <!-- GitHub Link -->
      <% if (theme.links) { %>
        <% for (const i in theme.links) {%>
          <a class="nav-icon nav-link" target="_blank" rel="noopener" href="<%- url_for(theme.links[i]) %>" title="GitHub"><span class="fa fa-<%= i %>"></span></a>
        <% } %>
      <% } %>

      <!-- Search -->
      <a class="nav-icon nav-search-btn" id="search-toggle" title="<%= __('search') %>"><span class="fa fa-search"></span></a>
    </nav>

    <!-- Search Form (expandable) -->
    <div id="search-form-wrap" class="search-form-wrap">
      <form action="/" method="get" class="search-form">
        <input type="search" id="search-input" class="search-form-input" placeholder="<%= searchPlaceholder %>">
        <button type="submit" class="search-form-submit">&#xF002;</button>
      </form>
      <div id="search-result" class="search-result"></div>
    </div>
  </div>
</header>

<script>
  // Local search (keep existing functionality)
  var searchData = null;
  var searchPath = "/search.xml";
  var currentLang = '<%= currentLang %>';
  var noResultMsg = '<%= __('no_results') %>';

  function loadSearchData() {
    if (searchData !== null) return;
    $.get(searchPath, function(data) { searchData = data; }, 'xml');
  }

  function getSearchResults(query) {
    if (!searchData) return [];
    var results = [], keywords = query.trim().toLowerCase().split(/\s+/);
    $(searchData).find('entry').each(function() {
      var title = $(this).find('title').text(),
          url = $(this).find('url').text(),
          content = $(this).find('content').text(),
          titleLower = title.toLowerCase(),
          contentLower = content.toLowerCase(),
          matchCount = 0;
      for (var i = 0; i < keywords.length; i++) {
        if (keywords[i]) {
          if (titleLower.indexOf(keywords[i]) > -1) matchCount += 2;
          if (contentLower.indexOf(keywords[i]) > -1) matchCount += 1;
        }
      }
      if (matchCount > 0) {
        var index = contentLower.indexOf(keywords[0] || ''),
            snippetStart = index > 50 ? index - 50 : 0,
            snippet = content.substring(snippetStart, snippetStart + 150);
        if (content.length > 150) snippet += '...';
        results.push({ title: title, url: url, snippet: snippet, score: matchCount });
      }
    });
    results.sort(function(a, b) { return b.score - a.score; });
    return results.slice(0, 20);
  }

  function renderSearchResults(results) {
    var html = '<div class="search-result-list">';
    if (results.length === 0) {
      html += '<div class="search-no-result"><p>' + noResultMsg + '</p></div>';
    } else {
      results.forEach(function(item) {
        html += '<div class="search-result-item"><a href="' + item.url + '" class="search-result-title">' + item.title + '</a><p class="search-result-content">' + item.snippet + '</p></div>';
      });
    }
    html += '</div>';
    return html;
  }

  function handleSearch(query) {
    if (!query) return;
    loadSearchData();
    var timer = setInterval(function() {
      if (searchData) {
        clearInterval(timer);
        $('#search-result').html(renderSearchResults(getSearchResults(query)));
      }
    }, 100);
    setTimeout(function() { clearInterval(timer); }, 2000);
  }

  // Sidebar drawer toggle
  function toggleSidebarDrawer() {
    var drawer = document.querySelector('.sidebar-drawer');
    var overlay = document.querySelector('.drawer-overlay');
    if (drawer && overlay) {
      var isOpen = drawer.classList.contains('is-open');
      if (isOpen) {
        drawer.classList.remove('is-open');
        overlay.classList.remove('is-visible');
      } else {
        drawer.classList.add('is-open');
        overlay.classList.add('is-visible');
      }
    }
  }

  function closeSidebarDrawer() {
    var drawer = document.querySelector('.sidebar-drawer');
    var overlay = document.querySelector('.drawer-overlay');
    if (drawer) drawer.classList.remove('is-open');
    if (overlay) overlay.classList.remove('is-visible');
  }

  // ============================================
  // Mobile Navigation Drawer - SA Architecture P0
  // ============================================
  function toggleMobileNavDrawer() {
    var drawer = document.getElementById('mobile-nav-drawer');
    var overlay = document.getElementById('mobile-nav-overlay');
    if (drawer && overlay) {
      var isOpen = drawer.classList.contains('is-open');
      if (isOpen) {
        closeMobileNavDrawer();
      } else {
        // Close sidebar drawer first (mutual exclusion)
        closeSidebarDrawer();
        drawer.classList.add('is-open');
        overlay.classList.add('is-visible');
        document.body.classList.add('nav-drawer-open');
      }
    }
  }

  function closeMobileNavDrawer() {
    var drawer = document.getElementById('mobile-nav-drawer');
    var overlay = document.getElementById('mobile-nav-overlay');
    if (drawer) drawer.classList.remove('is-open');
    if (overlay) overlay.classList.remove('is-visible');
    document.body.classList.remove('nav-drawer-open');
  }

  $(document).ready(function() {
    // Language switcher dropdown toggle
    $('.lang-switcher-btn').on('click', function(e) {
      e.stopPropagation();
      var $switcher = $(this).closest('.lang-switcher');
      
      // Close other dropdowns
      $('.lang-switcher').not($switcher).removeClass('open');
      
      // Toggle current
      $switcher.toggleClass('open');
      $(this).attr('aria-expanded', $switcher.hasClass('open'));
    });

    // Close language dropdown on outside click
    $(document).on('click', function() {
      $('.lang-switcher').removeClass('open');
      $('.lang-switcher-btn').attr('aria-expanded', 'false');
    });

    // ESC key handler - consolidated (see unified handler at end)

    // Search functionality - submit redirects to search page
    $('body').on('submit', '.search-form', function(e) {
      e.preventDefault();
      var query = $('#search-input').val().trim();
      if (query) {
        // Determine current language from URL path
        var searchPath = window.location.pathname.startsWith('/en/') ? '/en/search/' : '/search/';
        window.location.href = searchPath + '?q=' + encodeURIComponent(query);
      }
    });

    // URL query parameter on page load
    var urlParams = new URLSearchParams(window.location.search);
    var query = urlParams.get('q');
    if (query) {
      $('#search-input').val(decodeURIComponent(query));
      handleSearch(query);
    }

    // Search toggle button
    $('#search-toggle').on('click', function(e) {
      e.preventDefault();
      var wrap = $('#search-form-wrap');
      var input = $('#search-input');
      if (wrap.hasClass('on')) {
        wrap.removeClass('on');
        input.blur();
      } else {
        wrap.addClass('on');
        input.focus();
      }
    });

    // Sidebar drawer toggle (with mobile nav mutual exclusion)
    $('#sidebar-toggle').on('click', function(e) {
      e.preventDefault();
      closeMobileNavDrawer();  // Close mobile nav first
      toggleSidebarDrawer();
    });

    // Close drawer on overlay click
    $('.drawer-overlay').on('click', function() {
      closeSidebarDrawer();
    });

    // Close drawer on close button click
    $('#drawer-close').on('click', function() {
      closeSidebarDrawer();
    });

    // ESC key handler - consolidated (see unified handler at end)

    // Close drawer when a link inside is clicked
    $('.sidebar-drawer a').on('click', function() {
      closeSidebarDrawer();
    });

    // Header scroll behavior - add scrolled class
    var header = document.getElementById('header');
    if (header) {
      var scrollThreshold = 60;
      window.addEventListener('scroll', function() {
        if (window.scrollY > scrollThreshold) {
          header.classList.add('scrolled');
        } else {
          header.classList.remove('scrolled');
        }
      }, { passive: true });
    }

    // ============================================
    // Mobile Navigation Drawer Event Bindings
    // ============================================
    // Mobile menu toggle button (hamburger)
    $('#main-nav-toggle').on('click', function(e) {
      e.preventDefault();
      toggleMobileNavDrawer();
    });

    // Close button in mobile nav drawer
    $('#mobile-nav-close').on('click', function() {
      closeMobileNavDrawer();
    });

    // Overlay click to close mobile nav
    $('#mobile-nav-overlay').on('click', function() {
      closeMobileNavDrawer();
    });

    // Close mobile nav when a link inside is clicked
    $('#mobile-nav-drawer .mobile-nav-item').on('click', function() {
      closeMobileNavDrawer();
    });

    // Unified ESC key handler - closes all drawers/panels
    $(document).on('keydown', function(e) {
      if (e.key === 'Escape') {
        closeMobileNavDrawer();
        closeSidebarDrawer();
        $('#search-form-wrap').removeClass('on');
        $('#search-input').blur();
        $('.lang-switcher').removeClass('open');
        $('.lang-switcher-btn').attr('aria-expanded', 'false');
      }
    });

  });
</script>
