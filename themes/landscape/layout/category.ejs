<%
  var currentLang = page.lang || "zh-CN";

  // Get posts for this category
  var allPosts = (locals && locals.posts ? locals.posts.toArray() : (site.posts ? site.posts.toArray() : []));
  var filteredPosts = allPosts.filter(function(post) {
    var langMatch;
    if (currentLang === 'en') {
      langMatch = post.lang === 'en';
    } else if (currentLang === 'ko') {
      langMatch = post.lang === 'ko';
    } else if (currentLang === 'ja') {
      langMatch = post.lang === 'ja';
    } else {
      langMatch = post.lang !== 'en' && post.lang !== 'ko' && post.lang !== 'ja';
    }
    return langMatch && post.categories && post.categories.some(function(c) { return c.name === page.category; });
  });
%>

<!-- Simplified Hero -->
<section class="hero-section hero-simple">
  <div class="hero-content">
    <h1 class="hero-title"><%= page.category %></h1>
    <p class="hero-description"><%= filteredPosts.length %> <%= currentLang === 'en' ? 'posts' : currentLang === 'ko' ? '개의 글' : currentLang === 'ja' ? '記事' : '篇文章' %></p>
  </div>
</section>

<!-- Article Cards -->
<div class="article-card-list">
  <% if (filteredPosts && filteredPosts.length) { %>
    <% filteredPosts.forEach(function(post) { %>
      <article class="article-card">
        <h2 class="card-title">
          <a href="<%- post_url_i18n(post) %>"><%= post.title || '(no title)' %></a>
        </h2>
        <div class="card-meta">
          <span class="meta-item"><%- date(post.date, 'YYYY-MM-DD') %></span>
          <% if (post.categories && post.categories.length) { %>
            <span class="meta-item">
              <a href="<%- url_with_lang(post.categories.data[0].path, currentLang) %>"><%= post.categories.data[0].name %></a>
            </span>
          <% } %>
        </div>
        <% if (post.excerpt) { %>
        <div class="card-excerpt">
          <%- post.excerpt %>
        </div>
        <% } %>
        <% if (post.tags && post.tags.length) { %>
        <div class="card-tags">
          <% post.tags.forEach(function(tag) { %>
          <a href="<%- url_with_lang(tag.path, currentLang) %>" class="tag-pill">#<%= tag.name %></a>
          <% }) %>
        </div>
        <% } %>
        <div class="card-read-more">
          <a href="<%- post_url_i18n(post) %>"><%- currentLang === 'en' ? 'Read More &rarr;' : currentLang === 'ko' ? '더 읽기 &rarr;' : currentLang === 'ja' ? '続きを読む &rarr;' : '阅读更多 &rarr;' %></a>
        </div>
      </article>
    <% }); %>
  <% } else { %>
    <div class="article-card">
      <p><%= currentLang === 'en' ? 'No posts in this category.' : currentLang === 'ko' ? '이 카테고리에 글이 없습니다.' : currentLang === 'ja' ? 'このカテゴリーに記事がありません。' : '暂无相关文章。' %></p>
    </div>
  <% } %>
</div>
