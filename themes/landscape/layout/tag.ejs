<%
  var currentLang = page.lang || "zh-CN";

  // Get posts for this tag
  var allPosts = (locals && locals.posts ? locals.posts.toArray() : (site.posts ? site.posts.toArray() : []));
  var filteredPosts = allPosts.filter(function(post) {
      var langMatch;
      if (currentLang === 'en') {
        langMatch = post.lang === 'en';
      } else if (currentLang === 'ko') {
        langMatch = post.lang === 'ko';
      } else if (currentLang === 'ja') {
        langMatch = post.lang === 'ja';
      } else {
        langMatch = post.lang !== 'en' && post.lang !== 'ko' && post.lang !== 'ja';
      }
      return langMatch && post.tags && post.tags.some(function(t) { return t.name === page.tag; });
    });
  %>

  <!-- Simplified Hero -->
  <section class="hero-section hero-simple">
    <div class="hero-content">
      <p class="hero-description"><%= filteredPosts.length %> <%= __('posts_count') %></p>
    </div>
  </section>
</section>

<!-- Article Cards -->
<div class="article-card-list">
  <% if (filteredPosts && filteredPosts.length) { %>
    <% filteredPosts.forEach(function(post) { %>
      <article class="article-card">
        <h2 class="card-title">
          <a href="<%- post_url_i18n(post) %>"><%= post.title || '(no title)' %></a>
        </h2>
        <div class="card-meta">
          <span class="meta-item"><%- date(post.date, 'YYYY-MM-DD') %></span>
          <% if (post.categories && post.categories.length) { %>
            <span class="meta-item">
              <a href="<%- url_with_lang(post.categories.data[0].path, currentLang) %>"><%= post.categories.data[0].name %></a>
            </span>
          <% } %>
        </div>
        <% if (post.excerpt) { %>
        <div class="card-excerpt">
          <%- post.excerpt %>
        </div>
        <% } %>
        <div class="card-read-more">
          <a href="<%- post_url_i18n(post) %>"><%= __('read_more') %></a>
        </div>
      </article>
    <% }); %>
  <% } else { %>
    <div class="article-card">
      <p><%= __('no_posts_tag') %></p>
    </div>
  <% } %>
</div>
