<% if (page.type === 'tags') { %>
  <%- partial('tags') %>
<% } else if (page.type === 'categories') { %>
  <%- partial('categories') %>
<% } else if (page.layout === 'archive') { %>
  <%- partial('archive') %>
<% } else if (page.type === 'archives') { %>
  <%- partial('archive') %>
<% } else { %>
  <%- partial('_partial/article', {post: page, index: false}) %>
<% } %>
