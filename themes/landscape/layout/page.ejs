<%
  var currentLang = 'zh-CN';
  if (page && page.path && page.path.startsWith('en/')) {
    currentLang = 'en';
  }
%>

<!-- Simplified Hero -->
<section class="hero-section hero-simple">
  <div class="hero-content">
    <h1 class="hero-title"><%= page.title %></h1>
  </div>
</section>

<!-- Page Content -->
<div class="page-content">
  <%- page.content %>
</div>
