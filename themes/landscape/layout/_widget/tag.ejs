<% if (site.tags.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('tags') %></h3>
    <div class="widget">
      <%
        var currentLang = page.lang || "zh-CN";
        var filteredTags = filter_tags_by_lang(site.tags, currentLang);
      %>
      <% if (filteredTags.length > 0) { %>
        <ul class="tag-list" itemprop="keywords">
          <% filteredTags.forEach(function(tag){ %>
          <li class="tag-list-item">
            <a class="tag-list-link" href="<%- url_with_lang(tag.path, currentLang) %>" rel="tag">
              <%= tag.name %>
            </a>
            <% if (theme.show_count){ %>
            <span class="tag-list-count"><%= tag.length %></span>
            <% } %>
          </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </div>
<% } %>
