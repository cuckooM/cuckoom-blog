<% if (site.tags.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('tags') %></h3>
    <div class="widget">
      <%
        // Get current language from helper
        var currentLang = page.lang || "zh-CN";

        // Filter tags and recalculate counts based on language
        var filteredTags = site.tags.toArray().filter(function(tag) {
          if (currentLang === 'en') {
            return !/[\u4e00-\u9fa5]/.test(tag.name) && !/[\uac00-\ud7af]/.test(tag.name);
          }
          if (currentLang === 'ko') {
            return /[\uac00-\ud7af]/.test(tag.name);
          }
          return /[\u4e00-\u9fa5]/.test(tag.name);
        });

        // Recalculate tag counts based on language
        filteredTags = filteredTags.map(function(tag) {
          var posts = tag.posts.toArray().filter(function(post) {
            if (currentLang === 'en') {
              return post.lang === 'en' || (post.path && post.path.startsWith('en/'));
            }
            if (currentLang === 'ko') {
              return post.lang === 'ko' || (post.path && post.path.startsWith('ko/'));
            }
            return post.lang !== 'en' && post.lang !== 'ko' && !(post.path && (post.path.startsWith('en/') || post.path.startsWith('ko/')));
          });
          return {
            name: tag.name,
            path: tag.path,
            length: posts.length
          };
        });

        // Remove tags with zero posts
        filteredTags = filteredTags.filter(function(tag) {
          return tag.length > 0;
        });
      %>

      <% if (filteredTags.length > 0) { %>
        <ul class="tag-list" itemprop="keywords">
          <% filteredTags.forEach(function(tag){ %>
          <li class="tag-list-item">
            <a class="tag-list-link" href="<%- url_with_lang(tag.path, currentLang) %>" rel="tag">
              <%= tag.name %>
            </a>
            <% if (theme.show_count){ %>
            <span class="tag-list-count"><%= tag.length %></span>
            <% } %>
          </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </div>
<% } %>