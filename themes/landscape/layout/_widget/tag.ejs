<% if (site.tags.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('tags') %></h3>
    <div class="widget">
      <% if (page.section === 'en' && page.tag_names) { %>
        <ul class="tag-list" itemprop="keywords">
          <% if (Array.isArray(page.tag_names) && page.tag_names.length > 0) { %>
            <% page.tag_names.forEach(function(tagObj){ %>
            <li class="tag-list-item">
              <% var tagName = typeof tagObj === 'string' ? tagObj : tagObj.name; %>
              <a class="tag-list-link" href="<%- url_for('en/tags/' + tagName + '/') %>" rel="tag">
              <%= tagName %>
              </a>
            </li>
            <% }); %>
          <% } else { %>
          <% } %>
        </ul>
      <% } else { %>
      <%- list_tags({show_count: theme.show_count}) %>
      <% } %>
    </div>
  </div>
<% } %>
