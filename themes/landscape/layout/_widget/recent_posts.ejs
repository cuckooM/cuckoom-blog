<%
  // Get current language from pagePath parameter or page object
  var currentLang = 'zh-CN';

  // Check pagePath parameter first (passed from sidebar)
  if (typeof pagePath !== 'undefined' && pagePath && pagePath.startsWith('en/')) {
    currentLang = 'en';
  }
  // Check page object
  else if (typeof page !== 'undefined' && page && page.path && page.path.startsWith('en/')) {
    currentLang = 'en';
  }
  // Check localStorage for browser environment
  else if (typeof localStorage !== 'undefined' && typeof window !== 'undefined') {
    var langFromStorage = localStorage.getItem('preferredLang');
    if (langFromStorage === 'en' || langFromStorage === 'zh-CN') {
      currentLang = langFromStorage;
    }
  }
%>
<%
  // Get all posts from different sources
  var allPosts = [];
  if (page && page.posts && page.posts.toArray) {
    allPosts = page.posts.toArray();
  } else if (locals && locals.posts) {
    allPosts = locals.posts.toArray ? locals.posts.toArray() : (locals.posts.all ? locals.posts.all() : Array.from(locals.posts));
  } else if (site && site.posts) {
    allPosts = site.posts.toArray ? site.posts.toArray() : (site.posts.all ? site.posts.all() : Array.from(site.posts));
  }

  // Filter posts by language
  var filteredPosts = allPosts.filter(function(post) {
    var postLang = post.lang;
    if (!postLang) {
      // Default language detection based on path
      if (currentLang === 'en' && post.path && post.path.startsWith('en/')) {
        postLang = 'en';
      } else if (currentLang === 'zh-CN' && (!post.path || !post.path.startsWith('en/'))) {
        postLang = 'zh-CN';
      } else {
        postLang = currentLang;
      }
    }
    return (postLang === currentLang);
  });

  var limitedPosts = filteredPosts.slice(0, theme.recent_posts_limits);
%>
<% if (limitedPosts.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('recent_posts') %></h3>
    <div class="widget">
      <ul>
        <% limitedPosts.forEach(function(post){ %>
          <li>
            <a href="<%- url_for(post.path) %>"><%= post.title || '(no title)' %></a>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
<% } %>
