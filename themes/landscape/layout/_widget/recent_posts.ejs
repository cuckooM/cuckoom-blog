<%
  // Get current language from pagePath parameter or page object
  var currentLang = 'zh-CN';

  // Check pagePath parameter first (passed from sidebar)
  if (typeof pagePath !== 'undefined' && pagePath && pagePath.startsWith('en/')) {
    currentLang = 'en';
  }
  // Check page object
  else if (typeof page !== 'undefined' && page && page.path && page.path.startsWith('en/')) {
    currentLang = 'en';
  }
%>
<%
  // Get all posts from the site
  var allPosts = site.posts.toArray();

  // Filter posts by language based on the current page context
  var filteredPosts = allPosts.filter(function(post) {
    var postLang = post.lang || 'zh-CN'; // Default to Chinese if no lang specified
    return (currentLang === 'en') ? (postLang === 'en') : (postLang !== 'en');
  });

  // Sort by date (most recent first) and limit
  var sortedPosts = filteredPosts.sort(function(a, b) {
    return b.date - a.date;
  });

  var limitedPosts = sortedPosts.slice(0, theme.recent_posts_limits || 5);
%>
<% if (limitedPosts.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('recent_posts') %></h3>
    <div class="widget">
      <ul>
        <% limitedPosts.forEach(function(post){ %>
          <li>
            <a href="<%- url_for(post.path) %>"><%= post.title || '(no title)' %></a>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
<% } %>