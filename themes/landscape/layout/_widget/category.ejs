<% if (site.categories.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('categories') %></h3>
    <div class="widget">
      <%
         // Determine current language context based on path
         var currentPath = typeof pagePath !== 'undefined' ? pagePath : (page && page.path ? page.path : '');
         var isEnglishPage = currentPath && currentPath.startsWith('en/');

         // Get categories based on language context using our helper
         var filteredCategories = isEnglishPage ?
           getLangSpecificCategories('en') :
           site.categories.toArray().filter(function(category) {
             return /[\u4e00-\u9fa5]/.test(category.name);
           });
      %>

      <% if (filteredCategories.length > 0) { %>
        <ul class="category-list">
          <% filteredCategories.forEach(function(category){ %>
          <li class="category-list-item">
            <a class="category-list-link" href="<%- localized_url_for(category.path) %>">
              <%= category.name %>
            </a>
            <% if (theme.show_count){ %>
            <span class="category-list-count"><%= category.length %></span>
            <% } %>
          </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </div>
<% } %>