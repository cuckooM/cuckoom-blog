<% if (site.categories.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('categories') %></h3>
    <div class="widget">
      <%
        // Filter categories and recalculate counts based on language
        var filteredCategories = site.categories.toArray().filter(function(cat) {
          var filteredCategories = site.categories.toArray().filter(function(cat) {
                    if (page && page.path && page.path.startsWith('en/')) {
                      return !/[\u4e00-\u9fa5]/.test(cat.name);
                    }
                    return /[\u4e00-\u9fa5]/.test(cat.name);
                  });

                  // Recalculate category counts based on language
                  filteredCategories = filteredCategories.map(function(cat) {
                    var posts = cat.posts.toArray().filter(function(post) {
                      if (page && page.path && page.path.startsWith('en/')) {
                        return post.lang === 'en' || (post.path && post.path.startsWith('en/'));
                      }
                      return post.lang !== 'en' && !(post.path && post.path.startsWith('en/'));
                    });
                    return {
                      name: cat.name,
                      path: cat.path,
                      length: posts.length
                    };
                  });

                  // Remove categories with zero posts
                  filteredCategories = filteredCategories.filter(function(cat) {
                    return cat.length > 0;
                  });
                %>
        // Recalculate category counts based on language
        filteredCategories = filteredCategories.map(function(cat) {
          var posts = cat.posts.toArray().filter(function(post) {
            if (page && page.path && page.path.startsWith('en/')) {
              return post.lang === 'en' || (post.path && post.path.startsWith('en/'));
            }
            return post.lang !== 'en' && !(post.path && post.path.startsWith('en/'));
          });
          return {
            name: cat.name,
            path: cat.path,
            length: posts.length
          };
        });

        // Remove categories with zero posts
        filteredCategories = filteredCategories.filter(function(cat) {
          return cat.length > 0;
        });
      %>

      <% if (filteredCategories.length > 0) { %>
        <ul class="category-list">
          <% filteredCategories.forEach(function(category){ %>
          <li class="category-list-item">
            <a class="category-list-link" href="<%- localized_url_for(category.path) %>">
              <%= category.name %>
            </a>
            <% if (theme.show_count){ %>
            <span class="category-list-count"><%= category.length %></span>
            <% } %>
          </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </div>
<% } %>