<% if (site.tags.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('tags') %></h3>
    <div class="widget tagcloud">
      <%
        // Get current language from helper
        var currentLang = page.lang || "zh-CN";

        // Filter tags and recalculate counts based on language
        var filteredTags = site.tags.toArray().filter(function(tag) {
          if (currentLang === 'en') {
            return !/[\u4e00-\u9fa5]/.test(tag.name);
          }
          return /[\u4e00-\u9fa5]/.test(tag.name);
        });

        // Recalculate tag counts based on language
        filteredTags = filteredTags.map(function(tag) {
          var posts = tag.posts.toArray().filter(function(post) {
            if (currentLang === 'en') {
              return post.lang === 'en' || (post.path && post.path.startsWith('en/'));
            }
            return post.lang !== 'en' && !(post.path && post.path.startsWith('en/'));
          });
          return {
            name: tag.name,
            path: tag.path,
            length: posts.length
          };
        });

        // Remove tags with zero posts
        filteredTags = filteredTags.filter(function(tag) {
          return tag.length > 0;
        });

        // Calculate font sizes for tag cloud
         if (filteredTags.length > 0) {
           var counts = filteredTags.map(function(tag) { return tag.length; });
           var minCount = Math.min.apply(Math, counts);
           var maxCount = Math.max.apply(Math, counts);
           var minFont = 12;
           var maxFont = 24;

           // Generate tag cloud manually
          filteredTags.forEach(function(tag) {
            var ratio = (maxCount === minCount) ? 1 : (tag.length - minCount) / (maxCount - minCount);
            var fontSize = minFont + (maxFont - minFont) * ratio;
      %>
            <a href="<%= url_with_lang(tag.path, currentLang) %>" style="font-size: <%= fontSize %>px;"><%= tag.name %></a>
      <%
           });
         }
      %>
    </div>
  </div>
<% } %>