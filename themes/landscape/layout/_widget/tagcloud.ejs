<% if (site.tags.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('tagcloud') %></h3>
    <div class="widget tagcloud">
      <%
         // Determine current language context based on path
         var currentPath = typeof pagePath !== 'undefined' ? pagePath : (page && page.path ? page.path : '');
         var isEnglishPage = currentPath && currentPath.startsWith('en/');

         // Get tags based on language context using our helper
         var filteredTags = isEnglishPage ?
           getLangSpecificTags() :
           site.tags.toArray().filter(function(tag) {
             return /[\u4e00-\u9fa5]/.test(tag.name);
           });

         // Calculate min and max counts for font size calculation
         if (filteredTags.length > 0) {
           var counts = filteredTags.map(function(tag) { return tag.length; });
           var minCount = Math.min.apply(Math, counts);
           var maxCount = Math.max.apply(Math, counts);
           var minFont = 12;
           var maxFont = 24;

           // Generate tag cloud manually
           filteredTags.forEach(function(tag) {
             var ratio = (maxCount === minCount) ? 1 : (tag.length - minCount) / (maxCount - minCount);
             var fontSize = minFont + (maxFont - minFont) * ratio;
      %>
             <a href="<%= url_for(tag.path) %>" style="font-size: <%= fontSize %>px;"><%= tag.name %></a>
      <%
           });
         }
      %>
    </div>
  </div>
<% } %>