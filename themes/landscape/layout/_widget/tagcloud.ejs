<% if (site.tags.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('tagcloud') %></h3>
    <div class="widget tagcloud">
      <%
         // 分离中文和英文标签
         var chineseTags = [];
         var englishTags = [];

         site.tags.each(function(tag) {
           var name = tag.name;
           // 检测是否包含中文字符
           if (/[\u4e00-\u9fa5]/.test(name)) {
             chineseTags.push(tag);
           } else {
             englishTags.push(tag);
           }
         });
      %>

      <!-- 英文标签云 -->
      <% if (englishTags.length > 0) { %>
        <h4 class="language-section">English Tags</h4>
        <div class="tagcloud-section">
          <%- tagcloud({
            min_font: 12,
            max_font: 24,
            amount: 30,
            unit: 'px',
            span_style: 'display: inline-block; margin: 4px 6px 4px 0;',
            list_class: 'tagcloud-list',
            item_class: 'tagcloud-item',
            selected_tags: englishTags
          }) %>
        </div>
      <% } %>

      <!-- 中文标签云 -->
      <% if (chineseTags.length > 0) { %>
        <h4 class="language-section">中文标签</h4>
        <div class="tagcloud-section">
          <%- tagcloud({
            min_font: 12,
            max_font: 24,
            amount: 30,
            unit: 'px',
            span_style: 'display: inline-block; margin: 4px 6px 4px 0;',
            list_class: 'tagcloud-list',
            item_class: 'tagcloud-item',
            selected_tags: chineseTags
          }) %>
        </div>
      <% } %>
    </div>
  </div>
<% } %>