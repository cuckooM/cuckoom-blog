<% if (site.tags.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('tagcloud') %></h3>
    <div class="widget tagcloud">
      <% if (page.section === 'en' && page.tag_names && Array.isArray(page.tag_names) && page.tag_names.length > 0) { %>
        <%- generateEnglishTagcloud(page.tag_names) %>
      <% } else { %>
        <%- tagcloud() %>
      <% } %>
    </div>
  </div>
<% } %>