<% if (site.posts.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('archive_a') %></h3>
    <div class="widget">
      <ul class="archive-list">
        <%
        var currentLang = page.lang || "zh-CN";
        var filteredPosts = filter_posts_by_lang(site.posts.toArray(), currentLang);

        // Group posts by year and month
        var archives = {};
        filteredPosts.forEach(function(post) {
          var year = post.date.year();
          var month = post.date.format('MM');
          if (!archives[year]) archives[year] = {};
          if (!archives[year][month]) archives[year][month] = [];
          archives[year][month].push(post);
        });

        var langPrefix = get_lang_prefix(currentLang);
        var monthNames = get_month_names(currentLang);
        %>
        <% for (var year in archives) { %>
          <% var months = archives[year]; %>
          <% for (var month in months) { %>
            <li class="archive-list-item">
              <a class="archive-list-link" href="<%- url_for(langPrefix + 'archives/' + year + '/' + month + '/') %>">
                <%= monthNames[parseInt(month) - 1] %> <%= year %>
              </a>
              <span class="archive-list-count"><%= months[month].length %></span>
            </li>
          <% } %>
        <% } %>
      </ul>
    </div>
  </div>
<% } %>
