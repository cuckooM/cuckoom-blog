@import "nib"

// === Original variables (must come before components that use mq-* variables) ===
@import "_variables"

// === Design System (new) ===
@import "_design-system"
@import "_components/_card"
@import "_components/_hero"
@import "_components/_sidebar-drawer"

@import "_util/mixin"
@import "_util/grid"

global-reset()

input, button
  margin: 0
  padding: 0
  &::-moz-focus-inner
    border: 0
    padding: 0

// === Global body & layout ===
html, body, #container
  height: 100%

body
  background: var(--color-bg)
  font: var(--font-size-base) var(--font-sans)
  color: var(--color-text-primary)
  line-height: var(--line-height-base)
  -webkit-text-size-adjust: 100%

.outer
  clearfix()
  margin: 0 auto
  padding: 0 var(--space-md)

  @media screen and (min-width: 1024px)
    max-width: var(--header-max-width)
    padding: 0

.inner
  width: 100%

.left, .alignleft
  float: left

.right, .alignright
  float: right

.clear
  clear: both

#container
  position: relative

.mobile-nav-on
  overflow: hidden

#wrap
  height: 100%
  width: 100%
  position: absolute
  top: 0
  left: 0
  transition: 0.2s ease-out
  z-index: 1
  background: var(--color-bg)
  .mobile-nav-on &
    left: mobile-nav-width

// Main content area - centered, no sidebar
#main
  max-width: var(--content-max-width)
  margin: 0 auto

@import "_extend"
@import "_partial/header"
@import "_partial/article"
@import "_partial/comment"
@import "_partial/archive"
@import "_partial/footer"
@import "_partial/highlight"
@import "_partial/mobile"

if sidebar
  @import "_partial/sidebar"

@import "custom"