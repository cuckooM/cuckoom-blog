// ============================================
// Mobile Styles - Main Entry
// Imports mobile-nav-drawer module
// ============================================

// Import mobile navigation drawer module
@import "_partial/mobile-nav-drawer"

// === Mobile Menu Toggle Button ===
// Button in header for opening mobile nav
.mobile-menu-toggle
  display: none  // Hidden by default, shown only on mobile

  @media mq-mobile
    display: flex
    align-items: center
    justify-content: center
    width: var(--touch-target-min, 44px)
    height: var(--touch-target-min, 44px)
    background: transparent
    border: none
    border-radius: var(--radius-btn, 8px)
    cursor: pointer
    color: var(--color-text-secondary)
    transition: background var(--transition-fast, 0.2s ease), color var(--transition-fast, 0.2s ease)

    &:hover
      background: var(--color-tag-bg)
      color: var(--color-primary)

    &:focus
      outline: 2px solid var(--color-primary)
      outline-offset: 2px

    .fa
      font-size: 20px

// === Legacy Mobile Nav (deprecated, kept for backward compat) ===
@media mq-mobile
  #mobile-nav
    // Legacy simple nav - now replaced by drawer system
    // Kept minimal for any fallback scenarios
    display: none  // Hidden, using drawer instead

// === Mobile-specific Global Adjustments ===
@media mq-mobile
  // Adjust outer container padding
  .outer
    padding: 0 var(--space-md, 16px)

  // Hide desktop nav on mobile
  #main-nav
    .main-nav-link
      display: none  // Hide desktop nav links

// === Extra Small Screen (xs: ≤374px) ===
@media mq-xs
  .outer
    padding: 0 var(--space-sm, 8px)

  .mobile-menu-toggle
    width: 40px  // Slightly smaller but still usable
    height: 40px