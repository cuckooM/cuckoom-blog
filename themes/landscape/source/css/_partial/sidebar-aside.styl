#sidebar
  @media {mq-normal}
    column(sidebar-column)
    if sidebar is left
      float: left !important
    else
      float: right !important
    // Add top padding to align with main content
    padding-top: (block-margin - 18px)  // Add space equal to difference between article margin (50px) and widget-wrap margin (18px)

.widget-wrap
  margin: 18px 0
  background: #fff
  border-radius: 8px
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05)
  overflow: hidden
  transition: box-shadow 0.3s ease, transform 0.2s ease

  &:hover
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1)
    transform: translateY(-2px)

.widget-title
  padding: 16px 20px
  margin: 0
  background: linear-gradient(135deg, #f8f9fa 0%, #edf2f7 100%)
  color: #2d3748
  font-size: 16px
  font-weight: 600
  text-transform: uppercase
  letter-spacing: 0.5px
  border-bottom: 1px solid #e2e8f0
  position: relative

  &:before
    content: ''
    position: absolute
    left: 0
    bottom: 0
    width: 100%
    height: 2px
    background: linear-gradient(90deg, #4299e1, #38b2ac)
    opacity: 0
    transition: opacity 0.3s ease

  &:hover:before
    opacity: 1

.widget
  padding: 16px 20px
  color: #4a5568
  font-size: 14px
  line-height: 1.6
  text-shadow: none
  background: transparent
  box-shadow: none
  border: none
  border-radius: 0

  a
    color: #4299e1
    text-decoration: none
    transition: color 0.2s ease, padding-left 0.2s ease

    &:hover
      color: #2b6cb0
      text-decoration: underline

    &:active
      color: #2c5282

  ul, ol, dl
    margin: 0
    padding: 0
    list-style: none

    li
      padding: 8px 0
      border-bottom: 1px dashed #e2e8f0

      &:last-child
        border-bottom: none

      &:hover
        background-color: #f7fafc
        border-radius: 4px
        margin: 0 -16px
        padding-left: 16px
        padding-right: 16px

.category-list-count,
.tag-list-count,
.archive-list-count
  display: inline-block
  background-color: #e1f0fe
  color: #2b6cb0
  font-size: 12px
  font-weight: 500
  padding: 2px 8px
  border-radius: 12px
  margin-left: 8px
  min-width: auto
  vertical-align: middle
  transition: all 0.2s ease

  &:before
    content: ""

  &:after
    content: ""

.tagcloud
  padding: 10px 0

  a
    display: inline-block
    margin: 4px 6px 4px 0
    padding: 5px 12px
    background-color: #f1f5f8
    color: #4a5568
    border-radius: 20px
    text-decoration: none
    font-size: 12px
    transition: all 0.2s ease
    border: 1px solid #e2e8f0

    &:hover
      background-color: #4299e1
      color: white
      border-color: #4299e1
      transform: translateY(-2px)
      box-shadow: 0 4px 8px rgba(66, 153, 225, 0.3)

    &:nth-child(3n)
      background-color: #fef3f2
      color: #e53e3e

      &:hover
        background-color: #e53e3e
        color: white

    &:nth-child(4n)
      background-color: #ebf4ff
      color: #5a67d8

      &:hover
        background-color: #5a67d8
        color: white

    &:nth-child(5n)
      background-color: #f0fff4
      color: #38a169

      &:hover
        background-color: #38a169
        color: white

// 分类列表样式
.category-list
  li
    position: relative

    &.category-list-item
      padding: 6px 0

      .category-list-link
        display: flex
        justify-content: space-between
        align-items: center

        span:first-child
          flex-grow: 1

// 标签列表样式
.tag-list
  li
    padding: 6px 0

    .tag-list-link
      display: flex
      justify-content: space-between
      align-items: center

// 归档列表样式
.archive-list
  li
    padding: 6px 0

    .archive-list-link
      display: flex
      justify-content: space-between
      align-items: center

// 最新文章列表样式
.widget-recent-posts
  .recent-post-item
    padding: 10px 0
    border-bottom: 1px solid #e2e8f0

    &:last-child
      border-bottom: none

    .recent-post-title
      font-weight: 500
      color: #2d3748
      margin-bottom: 4px
      display: block
      transition: color 0.2s ease

      &:hover
        color: #4299e1

    .recent-post-date
      font-size: 12px
      color: #718096

// 响应式设计
@media (max-width: 768px)
  .widget-wrap
    margin: 12px 0
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08)

    .widget-title
      padding: 12px 16px
      font-size: 14px

    .widget
      padding: 12px 16px
      font-size: 13px

// 深色模式适配（可选）
@media (prefers-color-scheme: dark)
  .widget-wrap
    background: #2d3748
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2)

  .widget-title
    background: linear-gradient(135deg, #4a5568 0%, #2d3748 100%)
    color: #f7fafc
    border-bottom: 1px solid #4a5568

  .widget
    color: #e2e8f0

    a
      color: #63b3ed

      &:hover
        color: #90cdf4

    ul li
      border-bottom: 1px dashed #4a5568

      &:hover
        background-color: #4a5568