// ============================================
// Article Styles - Cards + Detail Page
// ============================================

// === Article Detail Page ===
.article-detail
  max-width: var(--content-max-width)
  margin: 0 auto
  padding: var(--space-2xl) var(--space-md)

  @media screen and (min-width: 768px)
    padding: var(--space-2xl) var(--space-lg)

  @media screen and (min-width: 1024px)
    padding: var(--space-2xl) 0

  // Meta bar below hero
  .article-meta-bar
    font-size: var(--font-size-sm)
    color: var(--color-text-secondary)
    margin-bottom: var(--space-xl)
    padding-bottom: var(--space-md)
    border-bottom: 1px solid var(--color-border)

    .meta-sep
      margin: 0 var(--space-xs)

    .meta-category
      color: var(--color-text-secondary)
      text-decoration: none

      &:hover
        color: var(--color-primary)

    .meta-tags
      display: inline

      .tag-pill
        margin-right: 4px

  // Article Body Typography
  .article-body
    font-size: var(--font-size-base)
    line-height: var(--line-height-base)
    color: var(--color-text-primary)

    h1, h2, h3, h4, h5, h6
      font-weight: 600
      line-height: var(--line-height-heading)
      color: var(--color-text-primary)

    h2
      font-size: 24px
      margin-top: 40px
      margin-bottom: var(--space-md)
      padding-bottom: var(--space-sm)
      border-bottom: 1px solid var(--color-border)

    h3
      font-size: 20px
      margin-top: 32px
      margin-bottom: 12px

    h4
      font-size: 17px
      margin-top: 24px
      margin-bottom: var(--space-sm)

    h5, h6
      font-size: var(--font-size-base)
      margin-top: 24px
      margin-bottom: var(--space-sm)

    p
      margin-bottom: var(--space-md)

    a
      color: var(--color-link)
      text-decoration: none

      &:hover
        text-decoration: underline

    // Lists
    ul, ol
      padding-left: 24px
      margin-bottom: var(--space-md)

      li
        margin-bottom: var(--space-sm)

    // Blockquotes
    blockquote
      border-left: 3px solid var(--color-primary)
      background: var(--color-tag-bg)
      padding: var(--space-md)
      margin: var(--space-md) 0
      border-radius: 0 var(--radius-btn) var(--radius-btn) 0

      p:last-child
        margin-bottom: 0

    // Code - Inline
    code
      background: var(--color-code-bg)
      padding: 2px 6px
      border-radius: var(--radius-tag)
      font-size: 0.9em
      font-family: var(--font-mono)

    // Code - Block
    pre, .highlight
      background: var(--color-code-bg)
      border-radius: var(--radius-btn)
      padding: var(--space-md)
      overflow-x: auto
      margin: var(--space-md) 0

      code
        background: none
        padding: 0

    // Tables
    table
      width: 100%
      border-collapse: collapse
      margin: var(--space-md) 0

      th
        background: var(--color-tag-bg)
        font-weight: 600
        padding: 12px 16px
        text-align: left
        border-bottom: 2px solid var(--color-border)

      td
        padding: 12px 16px
        border-bottom: 1px solid var(--color-border)

    // Images
    img
      max-width: 100%
      height: auto
      display: block
      margin: var(--space-md) auto
      border-radius: var(--radius-btn)

    // Horizontal rule
    hr
      border: none
      border-top: 1px solid var(--color-border)
      margin: var(--space-xl) 0

// === Post Navigation ===
.post-navigation
  display: grid
  grid-template-columns: 1fr 1fr
  gap: var(--space-md)
  max-width: var(--content-max-width)
  margin: var(--space-2xl) auto
  padding: 0 var(--space-md)

  @media screen and (min-width: 1024px)
    padding: 0

  .post-nav-item
    display: block
    padding: var(--space-md) var(--space-lg)
    background: var(--color-card-bg)
    border-radius: var(--radius-btn)
    box-shadow: var(--shadow-card)
    text-decoration: none
    transition: background var(--transition-fast), box-shadow var(--transition-fast)

    &:hover
      background: var(--color-tag-bg)
      box-shadow: var(--shadow-card-hover)

    .post-nav-label
      display: block
      font-size: var(--font-size-xs)
      color: var(--color-text-secondary)
      margin-bottom: var(--space-xs)

    .post-nav-title
      display: block
      font-size: var(--font-size-sm)
      font-weight: 500
      color: var(--color-text-primary)
      overflow: hidden
      text-overflow: ellipsis
      white-space: nowrap

  @media screen and (max-width: 767px)
    grid-template-columns: 1fr

// === Legacy article styles (backward compat) ===
.article
  margin: var(--space-xl) 0

.article-inner
  overflow: hidden

.article-meta
  clearfix()

.article-header
  padding: var(--space-lg) var(--space-lg) 0

.article-title
  text-decoration: none
  font-size: 2em
  font-weight: bold
  color: var(--color-text-primary)
  line-height: var(--line-height-heading)
  transition: color var(--transition-fast)

  a&:hover
    color: var(--color-primary)

.article-entry
  clearfix()
  color: var(--color-text-primary)
  padding: 0 var(--space-lg)

  p, table
    line-height: var(--line-height-base)
    margin: var(--line-height-base) 0

  h1, h2, h3, h4, h5, h6
    font-weight: bold
    line-height: var(--line-height-heading)
    margin: var(--line-height-heading) 0

  a
    color: var(--color-link)
    text-decoration: none

    &:hover
      text-decoration: underline

  ul, ol, dl
    margin-top: var(--line-height-base)
    margin-bottom: var(--line-height-base)

  img, video
    max-width: 100%
    height: auto
    display: block
    margin: auto

  iframe
    border: none

  table
    width: 100%
    border-collapse: collapse
    border-spacing: 0

  th
    font-weight: bold
    border-bottom: 3px solid var(--color-border)
    padding-bottom: 0.5em

  td
    border-bottom: 1px solid var(--color-border)
    padding: 10px 0

  blockquote
    margin: var(--line-height-base) 20px

  .video-container
    position: relative
    padding-top: 56.25%
    height: 0
    overflow: hidden

    iframe, object, embed
      position: absolute
      top: 0
      left: 0
      width: 100%
      height: 100%
      margin-top: 0

.article-footer
  clearfix()
  font-size: 0.85em
  line-height: var(--line-height-base)
  border-top: 1px solid var(--color-border)
  padding-top: var(--line-height-base)
  margin: 0 var(--space-lg) var(--space-md)

  a
    color: var(--color-text-secondary)
    text-decoration: none

    &:hover
      color: var(--color-text-primary)

.article-tag-list-item
  float: left
  margin-right: 10px

.article-tag-list-link
  &:before
    content: "#"

.article-comment-link
  float: right

.article-share-link
  cursor: pointer
  float: right
  margin-left: 20px

.article-more-link a
  display: inline-block
  line-height: 1em
  padding: 6px 15px
  border-radius: 15px
  background: var(--color-bg)
  color: var(--color-text-secondary)
  text-decoration: none

  &:hover
    background: var(--color-link)
    color: #fff
    text-decoration: none

// === Article Gallery ===
.article-gallery
  background: #000
  position: relative

.article-gallery-photos
  position: relative
  overflow: hidden

.article-gallery-img
  display: none
  max-width: 100%

  &:first-child
    display: block

  &.loaded
    position: absolute
    display: block

  img
    display: block
    max-width: 100%
    margin: 0 auto
