// ============================================
// Sidebar Styles - Hidden (replaced by drawer)
// ============================================

// Hide old sidebar since we use the drawer now
#sidebar
  display: none !important

// Widget styles (used by sidebar drawer)
.widget
  line-height: var(--line-height-base)
  word-wrap: break-word
  font-size: var(--font-size-sm)

  ul, ol
    list-style: none
    margin: 0

    ul, ol
      margin: 0

    ul
      list-style: disc

    ol
      list-style: decimal

.category-list-count,
.tag-list-count,
.archive-list-count
  display: inline-block
  background: var(--color-border)
  color: var(--color-text-secondary)
  font-size: var(--font-size-xxs)
  font-weight: 500
  padding: 2px 8px
  border-radius: 10px
  margin-left: var(--space-xs)
  min-width: auto
  vertical-align: middle

  &:before, &:after
    content: ""

.tagcloud
  a
    display: inline-block
    margin: 4px 6px 4px 0
    padding: 5px 12px
    background: var(--color-tag-bg)
    color: var(--color-tag-text)
    border-radius: 20px
    text-decoration: none
    font-size: 12px
    transition: all var(--transition-fast)

    &:hover
      background: var(--color-primary)
      color: #FFFFFF
