// ============================================
// Mobile Navigation Drawer Styles
// SA Architecture: Phase 1 P0 Implementation
// ============================================

// === Drawer Container ===
.mobile-nav-drawer
  position: fixed
  top: 0
  left: 0
  width: var(--mobile-nav-width, 280px)
  height: 100%
  background: var(--color-card-bg)
  z-index: var(--z-mobile-nav, 150)
  transform: translateX(-100%)
  transition: transform var(--transition-fast, 0.2s ease)
  box-shadow: var(--shadow-drawer, -4px 0 24px rgba(0, 0, 0, 0.12))
  display: flex
  flex-direction: column
  overflow-y: auto
  -webkit-overflow-scrolling: touch

  // Open state
  &.is-open
    transform: translateX(0)

// === Drawer Header ===
.mobile-nav-header
  display: flex
  align-items: center
  justify-content: space-between
  padding: var(--space-md, 16px)
  border-bottom: 1px solid var(--color-border)
  background: var(--color-card-bg)

  .mobile-nav-title
    font-size: var(--font-size-lg, 20px)
    font-weight: 600
    color: var(--color-text-primary)

  .mobile-nav-close
    width: var(--touch-target-min, 44px)
    height: var(--touch-target-min, 44px)
    display: flex
    align-items: center
    justify-content: center
    background: transparent
    border: none
    border-radius: var(--radius-btn, 8px)
    cursor: pointer
    color: var(--color-text-secondary)
    transition: background var(--transition-fast, 0.2s ease), color var(--transition-fast, 0.2s ease)

    &:hover
      background: var(--color-tag-bg)
      color: var(--color-text-primary)

    &:focus
      outline: 2px solid var(--color-primary)
      outline-offset: 2px

    .fa
      font-size: 20px

// === Navigation Links ===
.mobile-nav-links
  flex: 1
  padding: var(--space-sm, 8px) 0

  .mobile-nav-item
    display: flex
    align-items: center
    padding: 0 var(--space-md, 16px)
    height: var(--mobile-nav-item-height, 48px)
    color: var(--color-text-primary)
    font-size: var(--font-size-base, 16px)
    font-weight: 500
    text-decoration: none
    transition: background var(--transition-fast, 0.2s ease), color var(--transition-fast, 0.2s ease)
    border-left: 3px solid transparent

    &:hover
      background: var(--color-tag-bg)
      color: var(--color-primary)

    &:focus
      outline: 2px solid var(--color-primary)
      outline-offset: -2px

    &.active
      background: var(--color-tag-bg)
      color: var(--color-primary)
      border-left-color: var(--color-primary)

    .nav-item-text
      flex: 1

// === Drawer Footer ===
.mobile-nav-footer
  padding: var(--space-md, 16px)
  border-top: 1px solid var(--color-border)
  background: var(--color-card-bg)

  // Language switcher inside drawer
  .lang-switcher
    width: 100%

    .lang-switcher-btn
      width: 100%
      justify-content: flex-start
      padding: 12px var(--space-md, 16px)
      min-height: var(--touch-target-min, 44px)

    .lang-dropdown
      position: static
      width: 100%
      box-shadow: none
      border: 1px solid var(--color-border)
      margin-top: var(--space-xs, 4px)

// === Overlay ===
.mobile-nav-overlay
  position: fixed
  top: 0
  left: 0
  right: 0
  bottom: 0
  background: rgba(0, 0, 0, 0.3)
  z-index: var(--z-mobile-nav-overlay, 149)
  opacity: 0
  visibility: hidden
  transition: opacity var(--transition-fast, 0.2s ease), visibility var(--transition-fast, 0.2s ease)

  &.is-visible
    opacity: 1
    visibility: visible

// === Body Scroll Lock ===
body.nav-drawer-open
  overflow: hidden
  position: fixed
  width: 100%

// === Mobile Only - Show drawer, hide on desktop ===
@media mq-desktop
  .mobile-nav-drawer,
  .mobile-nav-overlay
    display: none

// === Extra Small Screen Adjustments (xs: ≤374px) ===
@media mq-xs
  .mobile-nav-drawer
    width: calc(100vw - 44px)  // Leave small margin for visual cue

  .mobile-nav-header
    padding: var(--space-sm, 8px)

  .mobile-nav-links
    .mobile-nav-item
      padding: 0 var(--space-sm, 8px)
      font-size: var(--font-size-sm, 14px)

  .mobile-nav-footer
    padding: var(--space-sm, 8px)