// ============================================
// Hero Section Component
// ============================================

.hero-section
  background: linear-gradient(135deg, var(--gradient-hero-start), var(--gradient-hero-end))
  padding: var(--space-3xl) var(--space-lg)
  padding-top: calc(var(--header-height) + var(--space-3xl))
  text-align: center
  color: #FFFFFF
  position: relative

  // Homepage full hero
  &.hero-full
    min-height: 100px
    max-height: 160px
    height: 18vh

    display: flex
    flex-direction: column
    align-items: center
    justify-content: center

  // Other pages simplified hero
  &.hero-simple
    min-height: 80px
    max-height: 120px
    height: 12vh

    display: flex
    flex-direction: column
    align-items: center
    justify-content: center

  .hero-content
    max-width: var(--hero-max-width)
    margin: 0 auto
    width: 100%

  .hero-title
    font-size: 32px
    font-weight: 700
    margin-bottom: var(--space-sm)
    line-height: var(--line-height-heading)

  .hero-subtitle
    font-size: 18px
    font-weight: 400
    opacity: 0.9
    margin-bottom: var(--space-md)
    line-height: var(--line-height-heading)

  .hero-description
    font-size: 15px
    font-weight: 400
    opacity: 0.8
    max-width: 600px
    margin: 0 auto

// Responsive adjustments
@media screen and (max-width: 767px)
  .hero-section
    padding: var(--space-lg) var(--space-md)

    &.hero-full
      height: auto
      min-height: 80px
      max-height: 100px

    &.hero-simple
      height: auto
      min-height: 60px
      max-height: 80px

    .hero-title
      font-size: 26px

    .hero-subtitle
      font-size: 16px

    .hero-description
      font-size: 14px

@media screen and (min-width: 768px) and (max-width: 1023px)
  .hero-section
    .hero-title
      font-size: 30px
