// ============================================
// Sidebar Drawer Component
// ============================================

.sidebar-drawer
  position: fixed
  right: calc(-1 * var(--sidebar-width) - var(--radius-card) - 10px)  // extra offset to fully hide border-radius curve
  top: var(--header-height)
  width: var(--sidebar-width)
  height: calc(100vh - var(--header-height))
  background: var(--color-card-bg)
  box-shadow: var(--shadow-drawer)
  z-index: 100
  transition: right var(--transition-normal)
  overflow-y: auto
  overflow-x: hidden  // prevent content overflow
  padding: var(--space-lg)
  border-radius: var(--radius-card) 0 0 var(--radius-card)

  &.is-open
    right: 0

  .drawer-close
    position: absolute
    top: var(--space-md)
    right: var(--space-md)
    font-size: 24px
    color: var(--color-text-secondary)
    cursor: pointer
    background: none
    border: none
    padding: var(--space-xs)
    line-height: 1

    &:hover
      color: var(--color-primary)

  .drawer-widget
    margin-bottom: var(--space-xl)

    &:last-child
      margin-bottom: 0

    .widget-title
      font-size: var(--font-size-lg)
      font-weight: 600
      color: var(--color-text-primary)
      padding-bottom: var(--space-sm)
      border-bottom: 1px solid var(--color-border)
      margin-bottom: var(--space-md)

    .widget-list
      list-style: none
      padding: 0
      margin: 0

      li
        font-size: var(--font-size-sm)
        color: var(--color-text-secondary)
        margin-bottom: var(--space-sm)

        &:last-child
          margin-bottom: 0

        a
          color: inherit
          text-decoration: none

          &:hover
            color: var(--color-primary)

      // Tag cloud widget
      &.tag-cloud
        display: flex
        flex-wrap: wrap
        gap: var(--space-sm)

        li
          margin-bottom: 0

          a
            display: inline-block
            background: var(--color-tag-bg)
            color: var(--color-tag-text)
            padding: var(--space-xs) 10px
            border-radius: var(--radius-tag)
            font-size: var(--font-size-xs)

      // Category/archive list with counts
      .widget-count
        display: inline-block
        background: var(--color-border)
        color: var(--color-text-secondary)
        font-size: var(--font-size-xxs)
        padding: 2px 8px
        border-radius: 10px
        margin-left: var(--space-xs)

// Overlay for drawer
.drawer-overlay
  position: fixed
  top: 0
  left: 0
  width: 100%
  height: 100%
  background: rgba(0, 0, 0, 0.3)
  z-index: 99
  opacity: 0
  visibility: hidden
  transition: opacity var(--transition-normal), visibility var(--transition-normal)

  &.is-visible
    opacity: 1
    visibility: visible

// Sidebar toggle button in header
.sidebar-toggle-btn
  display: none
  background: none
  border: none
  cursor: pointer
  font-size: 20px
  color: inherit
  padding: var(--space-xs)
  line-height: 1

  &:hover
    color: var(--color-primary)

// Mobile full-width drawer
@media screen and (max-width: 767px)
  .sidebar-drawer
    width: 100%
    right: -100%
    top: var(--header-height)
    height: calc(100vh - var(--header-height))
    border-radius: 0

// Show sidebar toggle on desktop (replaces old sidebar)
@media screen and (min-width: 768px)
  .sidebar-toggle-btn
    display: inline-block
