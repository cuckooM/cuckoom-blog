// ============================================
// Categories, Tags, Search, Page Styles
// ============================================

// === Category Grid ===
.category-grid
  max-width: var(--content-max-width)
  margin: 0 auto
  padding: var(--space-2xl) var(--space-md)
  display: grid
  grid-template-columns: 1fr
  gap: var(--space-lg)

  @media screen and (min-width: 768px)
    grid-template-columns: repeat(2, 1fr)

  @media screen and (min-width: 1024px)
    padding: var(--space-2xl) 0

.category-card
  display: block
  background: var(--color-card-bg)
  border-radius: var(--radius-card)
  padding: var(--space-lg)
  text-align: center
  text-decoration: none
  box-shadow: var(--shadow-card)
  transition: transform var(--transition-fast), box-shadow var(--transition-fast)

  &:hover
    transform: translateY(-2px)
    box-shadow: var(--shadow-card-hover)

  .category-card-icon
    font-size: 40px
    margin-bottom: var(--space-md)

  .category-card-name
    font-size: 18px
    font-weight: 600
    color: var(--color-text-primary)
    margin-bottom: var(--space-xs)

  .category-card-count
    font-size: var(--font-size-sm)
    color: var(--color-text-secondary)

.category-empty
  max-width: var(--content-max-width)
  margin: 0 auto
  padding: var(--space-2xl) var(--space-md)
  text-align: center
  color: var(--color-text-secondary)

// === Tags Cloud ===
.tags-cloud-section
  max-width: var(--content-max-width)
  margin: 0 auto
  padding: var(--space-2xl) var(--space-md)

  @media screen and (min-width: 1024px)
    padding: var(--space-2xl) 0

.tags-cloud
  display: flex
  flex-wrap: wrap
  justify-content: center
  gap: var(--space-md)
  margin-bottom: var(--space-2xl)
  padding: var(--space-lg)
  background: var(--color-card-bg)
  border-radius: var(--radius-card)
  box-shadow: var(--shadow-card)

  .tag-cloud-item
    color: var(--color-text-secondary)
    text-decoration: none
    padding: var(--space-xs) var(--space-sm)
    border-radius: var(--radius-tag)
    transition: color var(--transition-fast)

    &:hover
      color: var(--color-primary)

.tags-list-section
  .tags-list-grid
    display: grid
    grid-template-columns: repeat(2, 1fr)
    gap: var(--space-sm)

    @media screen and (min-width: 768px)
      grid-template-columns: repeat(3, 1fr)

    .tag-list-item
      display: flex
      justify-content: space-between
      align-items: center
      padding: var(--space-sm) var(--space-md)
      background: var(--color-card-bg)
      border-radius: var(--radius-btn)
      text-decoration: none
      transition: background var(--transition-fast)

      &:hover
        background: var(--color-tag-bg)

      .tag-list-name
        font-size: var(--font-size-sm)
        color: var(--color-text-primary)

      .tag-list-count
        font-size: var(--font-size-xxs)
        background: var(--color-border)
        color: var(--color-text-secondary)
        padding: 2px 8px
        border-radius: 10px

.tags-empty
  text-align: center
  padding: var(--space-2xl) 0
  color: var(--color-text-secondary)

// === Page Content (About, etc.) ===
.page-content
  max-width: var(--content-max-width)
  margin: 0 auto
  padding: var(--space-2xl) var(--space-md)

  @media screen and (min-width: 1024px)
    padding: var(--space-2xl) 0

  h1
    font-size: 2em
  h2
    font-size: 24px
    font-weight: 600
    margin-top: 40px
    margin-bottom: var(--space-md)
    padding-bottom: var(--space-sm)
    border-bottom: 1px solid var(--color-border)
  h3
    font-size: 20px
    font-weight: 600
    margin-top: 32px
    margin-bottom: 12px
  h4
    font-size: 17px
    font-weight: 600
    margin-top: 24px
    margin-bottom: var(--space-sm)
  p
    margin-bottom: var(--space-md)
    line-height: var(--line-height-base)
  a
    color: var(--color-link)
    text-decoration: none
    &:hover
      text-decoration: underline
  ul, ol
    padding-left: 24px
    margin-bottom: var(--space-md)
    li
      margin-bottom: var(--space-sm)
  blockquote
    border-left: 3px solid var(--color-primary)
    background: var(--color-tag-bg)
    padding: var(--space-md)
    margin: var(--space-md) 0
    border-radius: 0 var(--radius-btn) var(--radius-btn) 0
    p:last-child
      margin-bottom: 0
  code
    background: var(--color-code-bg)
    padding: 2px 6px
    border-radius: var(--radius-tag)
    font-size: 0.9em
    font-family: var(--font-mono)
  pre, .highlight
    background: var(--color-code-bg)
    border-radius: var(--radius-btn)
    padding: var(--space-md)
    overflow-x: auto
    margin: var(--space-md) 0
    code
      background: none
      padding: 0
  table
    width: 100%
    border-collapse: collapse
    margin: var(--space-md) 0
    th
      background: var(--color-tag-bg)
      font-weight: 600
      padding: 12px 16px
      text-align: left
      border-bottom: 2px solid var(--color-border)
    td
      padding: 12px 16px
      border-bottom: 1px solid var(--color-border)
  img
    max-width: 100%
    height: auto
    display: block
    margin: var(--space-md) auto
    border-radius: var(--radius-btn)
  hr
    border: none
    border-top: 1px solid var(--color-border)
    margin: var(--space-xl) 0

  // Mobile table overflow handling
  @media screen and (max-width: 767px)
    table
      display: block
      overflow-x: auto

// === Search Page ===
.search-page-container
  max-width: var(--content-max-width)
  margin: 0 auto
  padding: var(--space-xl) var(--space-md)

  @media screen and (min-width: 1024px)
    padding: var(--space-xl) 0

.search-page-box
  max-width: 560px
  margin: 0 auto var(--space-xl)

.search-page-form
  position: relative
  display: flex
  align-items: center

.search-page-icon
  position: absolute
  left: var(--space-md)
  font: 16px forkawesome
  color: var(--color-text-secondary)
  pointer-events: none

.search-page-input
  width: 100%
  height: 48px
  padding: var(--space-sm) var(--space-md) var(--space-sm) 44px
  border: 1px solid var(--color-border)
  border-radius: var(--radius-input)
  background: var(--color-card-bg)
  color: var(--color-text-primary)
  font: var(--font-size-base) var(--font-sans)
  outline: none
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast)

  &:focus
    border-color: var(--color-primary)
    box-shadow: 0 0 0 4px rgba(74, 144, 217, 0.1)

  &::placeholder
    color: var(--color-text-secondary)

.search-page-results
  margin-top: var(--space-lg)

.search-page-result-item
  display: block
  padding: var(--space-md)
  border-bottom: 1px solid var(--color-border)
  text-decoration: none
  transition: background var(--transition-fast)

  &:hover
    background: var(--color-tag-bg)

  &:last-child
    border-bottom: none

  .search-page-result-title
    font-size: 17px
    font-weight: 600
    color: var(--color-link)
    margin-bottom: var(--space-xs)

  .search-page-result-snippet
    font-size: var(--font-size-sm)
    color: var(--color-text-secondary)
    margin: 0

.search-page-empty
  text-align: center
  padding: var(--space-2xl) 0
  color: var(--color-text-secondary)
  font-size: var(--font-size-sm)
