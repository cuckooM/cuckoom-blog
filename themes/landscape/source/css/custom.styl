// Custom styles import
@import "custom/pages"
@import "custom/bugfixes"

// Global overrides for redesign
body
  font-family: var(--font-sans)

// Ensure smooth transitions for theme switching
*, *::before, *::after
  transition: background-color var(--transition-normal), color var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal)

// Prevent transition on initial page load
.no-transitions *,
.no-transitions *::before,
.no-transitions *::after
  transition: none !important

// Link styling
a
  color: var(--color-link)

  &:hover
    color: var(--color-primary)

// Selection color
::selection
  background: var(--color-primary)
  color: #FFFFFF
